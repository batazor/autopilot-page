---
// Client-side zone/point labeling editor. The image never leaves the browser:
// users drop a screenshot, place labeled points (Dreamscape scenes) or drag
// labeled rectangles (area.yaml-style regions), and export a JSON with
// percentage coordinates that maintainers can import directly.
//
// The points surface mirrors the dashboard's ScenePointEditor
// (web/components/dreamscape/ScenePointEditor.tsx): full-width image, numbered
// pin buttons, hover highlight synced with the list, click-to-select, drag
// with a 3px threshold so a plain click still selects.
---

<div id="lbl-editor" class="not-content">
  <div class="lbl-toolbar">
    <div class="lbl-mode" role="group" aria-label="Editor mode">
      <button type="button" data-mode="points" class="lbl-mode-btn active">Points (Dreamscape scene)</button>
      <button type="button" data-mode="zones" class="lbl-mode-btn">Zones (screen regions)</button>
    </div>
    <div class="lbl-actions">
      <label class="lbl-btn">
        Load image
        <input id="lbl-file" type="file" accept="image/*" hidden />
      </label>
      <label class="lbl-btn">
        Import JSON
        <input id="lbl-import" type="file" accept="application/json,.json" hidden />
      </label>
      <button type="button" id="lbl-export" class="lbl-btn primary">Download JSON</button>
      <button type="button" id="lbl-copy" class="lbl-btn">Copy JSON</button>
      <button type="button" id="lbl-clear" class="lbl-btn danger">Clear</button>
    </div>
  </div>

  <div class="lbl-meta" id="lbl-meta-points">
    <label>slug <input id="lbl-slug" type="text" placeholder="frost-harbor" spellcheck="false" /></label>
    <label>title <input id="lbl-title" type="text" placeholder="Frost Harbor" /></label>
    <label>season <input id="lbl-season" type="number" min="1" step="1" value="1" /></label>
  </div>
  <div class="lbl-meta" id="lbl-meta-zones" hidden>
    <label>screen <input id="lbl-screen" type="text" placeholder="hero_detail" spellcheck="false" /></label>
  </div>

  <div class="lbl-body">
    <div>
      <div class="lbl-tip" id="lbl-tip">Click on the image to add a point.</div>
      <div class="lbl-stage" id="lbl-stage">
        <div class="lbl-drop" id="lbl-drop">
          <p><strong>Drop a screenshot here</strong>, paste it (Ctrl/Cmd+V), or use “Load image”.</p>
          <p class="lbl-hint">The image stays on your device — only the JSON with coordinates is exported.</p>
        </div>
        <div class="lbl-canvas" id="lbl-canvas" hidden>
          <img id="lbl-img" alt="Screenshot being labeled" draggable="false" />
          <div class="lbl-overlay" id="lbl-overlay"></div>
        </div>
      </div>
      <div class="lbl-badges" id="lbl-badges"></div>
    </div>
    <div class="lbl-side">
      <div class="lbl-side-head" id="lbl-count">0 items</div>
      <ol class="lbl-list" id="lbl-list"></ol>
    </div>
  </div>

  <details class="lbl-json">
    <summary>JSON preview</summary>
    <pre><code id="lbl-json-out">{}</code></pre>
  </details>
</div>

<script>
  type Pt = { n: number; name: string; xPct: number; yPct: number };
  type Zn = { name: string; bbox: [number, number, number, number] };

  const root = document.getElementById('lbl-editor');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const overlay = $('lbl-overlay');
    const canvas = $('lbl-canvas');
    const drop = $('lbl-drop');
    const stage = $('lbl-stage');
    const img = $('lbl-img') as unknown as HTMLImageElement;
    const list = $('lbl-list');
    const jsonOut = $('lbl-json-out');
    const tip = $('lbl-tip');
    const badges = $('lbl-badges');

    let mode: 'points' | 'zones' = 'points';
    let points: Pt[] = [];
    let zones: Zn[] = [];
    let imageName = '';
    // Points are keyed by their number (like the dashboard editor); zones by index.
    let selectedN: number | null = null;
    let hoveredN: number | null = null;
    let selectedZone = -1;

    const LS_KEY = 'autopilot-label-editor';

    const r2 = (v: number) => Math.round(v * 100) / 100;
    const clampPct = (v: number) => Math.min(100, Math.max(0, v));
    const capture = (el: Element, id: number) => {
      try {
        el.setPointerCapture(id);
      } catch {
        /* synthetic/stale pointer — drag still works while the cursor stays on the element */
      }
    };

    function pctFromClient(clientX: number, clientY: number): { x: number; y: number } {
      const r = overlay.getBoundingClientRect();
      return {
        x: r2(clampPct(((clientX - r.left) / r.width) * 100)),
        y: r2(clampPct(((clientY - r.top) / r.height) * 100)),
      };
    }

    function payload(): Record<string, unknown> {
      if (mode === 'points') {
        return {
          type: 'dreamscape_scene',
          slug: ($('lbl-slug') as HTMLInputElement).value.trim(),
          title: ($('lbl-title') as HTMLInputElement).value.trim(),
          season: parseInt(($('lbl-season') as HTMLInputElement).value, 10) || 1,
          image: imageName,
          points: [...points].sort((a, b) => a.n - b.n),
        };
      }
      return {
        type: 'regions',
        screen: ($('lbl-screen') as HTMLInputElement).value.trim(),
        image: imageName,
        regions: zones.map((z) => ({ name: z.name, bbox: z.bbox.map(r2) })),
      };
    }

    function save() {
      try {
        localStorage.setItem(
          LS_KEY,
          JSON.stringify({ mode, imageName, points, zones, meta: metaValues() }),
        );
      } catch {
        /* storage full / private mode — autosave is best-effort */
      }
    }

    function metaValues() {
      return {
        slug: ($('lbl-slug') as HTMLInputElement).value,
        title: ($('lbl-title') as HTMLInputElement).value,
        season: ($('lbl-season') as HTMLInputElement).value,
        screen: ($('lbl-screen') as HTMLInputElement).value,
      };
    }

    function restore() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) return;
        const s = JSON.parse(raw);
        if (Array.isArray(s.points)) points = s.points;
        if (Array.isArray(s.zones)) zones = s.zones;
        if (s.mode === 'zones' || s.mode === 'points') setMode(s.mode, false);
        if (s.imageName) imageName = s.imageName;
        const m = s.meta || {};
        ($('lbl-slug') as HTMLInputElement).value = m.slug || '';
        ($('lbl-title') as HTMLInputElement).value = m.title || '';
        ($('lbl-season') as HTMLInputElement).value = m.season || '1';
        ($('lbl-screen') as HTMLInputElement).value = m.screen || '';
      } catch {
        /* corrupt autosave — start clean */
      }
    }

    const highlightedN = () => hoveredN ?? selectedN;

    function refreshJson() {
      jsonOut.textContent = JSON.stringify(payload(), null, 2);
      if (mode === 'points') updateBadges();
      save();
    }

    function updateBadges() {
      badges.innerHTML = '';
      const unnamed = points.filter((p) => !p.name.trim()).length;
      if (unnamed) {
        const b = document.createElement('span');
        b.className = 'lbl-badge';
        b.textContent = `${unnamed} unnamed`;
        badges.appendChild(b);
      }
    }

    function render() {
      overlay.innerHTML = '';
      list.innerHTML = '';
      badges.innerHTML = '';
      const count = mode === 'points' ? points.length : zones.length;
      $('lbl-count').textContent = `${count} item${count === 1 ? '' : 's'}`;

      if (mode === 'points') {
        tip.textContent =
          selectedN != null
            ? `Pin #${selectedN} selected. Drag a pin to move it, or click empty space to add one`
            : 'Drag a pin to move it, click to select, or click empty space to add one';
        points.forEach((p) => {
          overlay.appendChild(pinFor(p));
          list.appendChild(pointRowFor(p));
        });
      } else {
        tip.textContent =
          'Drag on the image to draw a zone. Drag a zone to move it, corner to resize.';
        zones.forEach((z, i) => {
          overlay.appendChild(zoneFor(z, i));
          list.appendChild(zoneRowFor(z, i));
        });
      }
      refreshJson();
    }

    // Re-apply highlight classes without rebuilding the DOM (keeps hover cheap
    // and inputs focused).
    function paintHighlight() {
      const h = highlightedN();
      overlay.querySelectorAll<HTMLElement>('.lbl-pin').forEach((el) => {
        el.classList.toggle('hl', Number(el.dataset.n) === h);
      });
      list.querySelectorAll<HTMLElement>('li[data-n]').forEach((el) => {
        el.classList.toggle('hl', Number(el.dataset.n) === h);
      });
    }

    function setHovered(n: number | null) {
      hoveredN = n;
      paintHighlight();
    }
    function setSelected(n: number | null) {
      selectedN = n;
      tip.textContent =
        n != null
          ? `Pin #${n} selected. Drag a pin to move it, or click empty space to add one`
          : 'Drag a pin to move it, click to select, or click empty space to add one';
      paintHighlight();
    }

    // --- points: pins + list rows (mirrors the dashboard ScenePointEditor) ---

    function pinFor(p: Pt): HTMLButtonElement {
      const pin = document.createElement('button');
      pin.type = 'button';
      pin.className = 'lbl-pin' + (highlightedN() === p.n ? ' hl' : '');
      pin.dataset.n = String(p.n);
      pin.style.left = p.xPct + '%';
      pin.style.top = p.yPct + '%';
      pin.textContent = String(p.n);
      pin.title = `${p.n}. ${p.name || '(unnamed)'} — drag to move`;
      pin.addEventListener('mouseenter', () => setHovered(p.n));
      pin.addEventListener('mouseleave', () => setHovered(null));

      let drag: { startX: number; startY: number; moved: boolean } | null = null;
      pin.addEventListener('pointerdown', (ev) => {
        ev.stopPropagation();
        ev.preventDefault();
        drag = { startX: ev.clientX, startY: ev.clientY, moved: false };
        capture(pin, ev.pointerId);
      });
      pin.addEventListener('pointermove', (ev) => {
        if (!drag) return;
        // Ignore sub-threshold jitter so a plain click still selects.
        if (!drag.moved && Math.hypot(ev.clientX - drag.startX, ev.clientY - drag.startY) < 3)
          return;
        drag.moved = true;
        const { x, y } = pctFromClient(ev.clientX, ev.clientY);
        p.xPct = x;
        p.yPct = y;
        pin.style.left = x + '%';
        pin.style.top = y + '%';
        const row = list.querySelector(`li[data-n="${p.n}"] .lbl-row-coords`);
        if (row) row.textContent = `${x}%, ${y}%`;
      });
      pin.addEventListener('pointerup', () => {
        if (!drag) return;
        const wasDrag = drag.moved;
        drag = null;
        if (wasDrag) refreshJson();
        else setSelected(selectedN === p.n ? null : p.n); // plain click → toggle selection
      });
      pin.addEventListener('pointercancel', () => (drag = null));
      return pin;
    }

    function pointRowFor(p: Pt): HTMLLIElement {
      const li = document.createElement('li');
      li.dataset.n = String(p.n);
      li.className = highlightedN() === p.n ? 'hl' : '';
      li.addEventListener('mouseenter', () => setHovered(p.n));
      li.addEventListener('mouseleave', () => setHovered(null));

      const numEl = document.createElement('button');
      numEl.type = 'button';
      numEl.className = 'lbl-row-n';
      numEl.textContent = String(p.n);
      numEl.addEventListener('click', () => setSelected(selectedN === p.n ? null : p.n));

      const nameEl = document.createElement('input');
      nameEl.type = 'text';
      nameEl.value = p.name;
      nameEl.placeholder = `Item ${p.n}`;
      nameEl.addEventListener('focus', () => setHovered(p.n));
      nameEl.addEventListener('blur', () => setHovered(null));
      nameEl.addEventListener('input', () => {
        p.name = nameEl.value;
        refreshJson();
      });

      const coordEl = document.createElement('span');
      coordEl.className = 'lbl-row-coords';
      coordEl.textContent = `${r2(p.xPct)}%, ${r2(p.yPct)}%`;

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'lbl-row-del';
      del.textContent = '✕';
      del.title = 'Remove';
      del.addEventListener('click', () => {
        points = points.filter((pp) => pp.n !== p.n);
        if (selectedN === p.n) selectedN = null;
        render();
      });

      li.append(numEl, nameEl, coordEl, del);
      return li;
    }

    // --- zones: rects + list rows ---

    function zoneFor(z: Zn, i: number): HTMLDivElement {
      const el = document.createElement('div');
      el.className = 'lbl-zone' + (i === selectedZone ? ' sel' : '');
      const [x, y, w, h] = z.bbox;
      el.style.left = x + '%';
      el.style.top = y + '%';
      el.style.width = w + '%';
      el.style.height = h + '%';
      const tag = document.createElement('span');
      tag.className = 'lbl-zone-tag';
      tag.textContent = z.name || `zone ${i + 1}`;
      el.appendChild(tag);
      const handle = document.createElement('div');
      handle.className = 'lbl-zone-handle';
      el.appendChild(handle);

      // Move the whole zone.
      el.addEventListener('pointerdown', (ev) => {
        if (ev.target === handle) return;
        ev.stopPropagation();
        ev.preventDefault();
        selectedZone = i;
        capture(el, ev.pointerId);
        const start = pctFromClient(ev.clientX, ev.clientY);
        const [bx, by] = [z.bbox[0], z.bbox[1]];
        const move = (mv: PointerEvent) => {
          const cur = pctFromClient(mv.clientX, mv.clientY);
          const [, , w2, h2] = z.bbox;
          z.bbox[0] = r2(Math.min(100 - w2, Math.max(0, bx + cur.x - start.x)));
          z.bbox[1] = r2(Math.min(100 - h2, Math.max(0, by + cur.y - start.y)));
          el.style.left = z.bbox[0] + '%';
          el.style.top = z.bbox[1] + '%';
        };
        const up = () => {
          el.removeEventListener('pointermove', move);
          el.removeEventListener('pointerup', up);
          render();
        };
        el.addEventListener('pointermove', move);
        el.addEventListener('pointerup', up);
      });
      // Resize from the bottom-right handle.
      handle.addEventListener('pointerdown', (ev) => {
        ev.stopPropagation();
        ev.preventDefault();
        selectedZone = i;
        capture(handle, ev.pointerId);
        const move = (mv: PointerEvent) => {
          const cur = pctFromClient(mv.clientX, mv.clientY);
          const [x2, y2] = z.bbox;
          z.bbox[2] = r2(Math.max(0.5, cur.x - x2));
          z.bbox[3] = r2(Math.max(0.5, cur.y - y2));
          el.style.width = z.bbox[2] + '%';
          el.style.height = z.bbox[3] + '%';
        };
        const up = () => {
          handle.removeEventListener('pointermove', move);
          handle.removeEventListener('pointerup', up);
          render();
        };
        handle.addEventListener('pointermove', move);
        handle.addEventListener('pointerup', up);
      });
      return el;
    }

    function zoneRowFor(z: Zn, i: number): HTMLLIElement {
      const li = document.createElement('li');
      li.className = i === selectedZone ? 'hl' : '';
      const numEl = document.createElement('span');
      numEl.className = 'lbl-row-n';
      numEl.textContent = String(i + 1);
      const nameEl = document.createElement('input');
      nameEl.type = 'text';
      nameEl.value = z.name;
      nameEl.placeholder = 'region name';
      nameEl.addEventListener('input', () => {
        z.name = nameEl.value;
        const tag = overlay.querySelectorAll('.lbl-zone-tag')[i];
        if (tag) tag.textContent = z.name || `zone ${i + 1}`;
        refreshJson();
      });
      const coordEl = document.createElement('span');
      coordEl.className = 'lbl-row-coords';
      coordEl.textContent = `[${z.bbox.map(r2).join(', ')}]`;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'lbl-row-del';
      del.textContent = '✕';
      del.title = 'Remove';
      del.addEventListener('click', () => {
        zones.splice(i, 1);
        selectedZone = -1;
        render();
      });
      li.addEventListener('click', (e) => {
        if (e.target === del || e.target === nameEl) return;
        selectedZone = i;
        render();
      });
      li.append(numEl, nameEl, coordEl, del);
      return li;
    }

    // --- empty-space interactions on the overlay ---

    overlay.addEventListener('pointerdown', (ev) => {
      if (ev.target !== overlay) return;
      ev.preventDefault();
      if (mode === 'points') {
        const { x, y } = pctFromClient(ev.clientX, ev.clientY);
        // Add a new pin with the next free number.
        const n = points.reduce((m, p) => Math.max(m, p.n), 0) + 1;
        points.push({ n, name: '', xPct: x, yPct: y });
        selectedN = n;
        render();
        const inp = list.querySelector<HTMLInputElement>(`li[data-n="${n}"] input[type=text]`);
        inp?.focus();
      } else {
        // Drag out a new zone.
        capture(overlay, ev.pointerId);
        const start = pctFromClient(ev.clientX, ev.clientY);
        const ghost = document.createElement('div');
        ghost.className = 'lbl-zone ghost';
        overlay.appendChild(ghost);
        const move = (mv: PointerEvent) => {
          const cur = pctFromClient(mv.clientX, mv.clientY);
          ghost.style.left = Math.min(start.x, cur.x) + '%';
          ghost.style.top = Math.min(start.y, cur.y) + '%';
          ghost.style.width = Math.abs(cur.x - start.x) + '%';
          ghost.style.height = Math.abs(cur.y - start.y) + '%';
        };
        const up = (uv: PointerEvent) => {
          overlay.removeEventListener('pointermove', move);
          overlay.removeEventListener('pointerup', up);
          ghost.remove();
          const cur = pctFromClient(uv.clientX, uv.clientY);
          const w = Math.abs(cur.x - start.x);
          const h = Math.abs(cur.y - start.y);
          if (w >= 0.5 && h >= 0.5) {
            zones.push({
              name: '',
              bbox: [r2(Math.min(start.x, cur.x)), r2(Math.min(start.y, cur.y)), r2(w), r2(h)],
            });
            selectedZone = zones.length - 1;
            render();
            const inputs = list.querySelectorAll<HTMLInputElement>('input[type=text]');
            inputs[inputs.length - 1]?.focus();
          }
        };
        overlay.addEventListener('pointermove', move);
        overlay.addEventListener('pointerup', up);
      }
    });

    // --- image loading ---

    function loadImage(file: File) {
      if (!file.type.startsWith('image/')) return;
      imageName = file.name;
      const url = URL.createObjectURL(file);
      img.onload = () => URL.revokeObjectURL(url);
      img.src = url;
      drop.hidden = true;
      canvas.hidden = false;
      render();
    }

    $('lbl-file').addEventListener('change', (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (f) loadImage(f);
    });
    ['dragover', 'dragenter'].forEach((t) =>
      stage.addEventListener(t, (e) => {
        e.preventDefault();
        stage.classList.add('over');
      }),
    );
    ['dragleave', 'drop'].forEach((t) =>
      stage.addEventListener(t, (e) => {
        e.preventDefault();
        stage.classList.remove('over');
      }),
    );
    stage.addEventListener('drop', (e) => {
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) loadImage(f);
    });
    document.addEventListener('paste', (e) => {
      const item = Array.from(e.clipboardData?.items ?? []).find((i) =>
        i.type.startsWith('image/'),
      );
      const f = item?.getAsFile();
      if (f) loadImage(new File([f], f.name || 'pasted.png', { type: f.type }));
    });

    // --- mode / import / export ---

    function setMode(m: 'points' | 'zones', rerender = true) {
      mode = m;
      selectedN = null;
      selectedZone = -1;
      root.querySelectorAll<HTMLButtonElement>('.lbl-mode-btn').forEach((b) => {
        b.classList.toggle('active', b.dataset.mode === m);
      });
      $('lbl-meta-points').hidden = m !== 'points';
      $('lbl-meta-zones').hidden = m !== 'zones';
      if (rerender) render();
    }
    root.querySelectorAll<HTMLButtonElement>('.lbl-mode-btn').forEach((b) => {
      b.addEventListener('click', () => setMode(b.dataset.mode as 'points' | 'zones'));
    });

    $('lbl-import').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data.type === 'regions' || Array.isArray(data.regions)) {
          zones = (data.regions ?? []).map((r: Zn) => ({
            name: String(r.name ?? ''),
            bbox: [r.bbox?.[0] ?? 0, r.bbox?.[1] ?? 0, r.bbox?.[2] ?? 1, r.bbox?.[3] ?? 1],
          }));
          ($('lbl-screen') as HTMLInputElement).value = data.screen ?? '';
          setMode('zones');
        } else {
          points = (data.points ?? []).map((p: Pt, idx: number) => ({
            n: Number(p.n ?? idx + 1),
            name: String(p.name ?? ''),
            xPct: Number(p.xPct ?? 0),
            yPct: Number(p.yPct ?? 0),
          }));
          ($('lbl-slug') as HTMLInputElement).value = data.slug ?? '';
          ($('lbl-title') as HTMLInputElement).value = data.title ?? '';
          ($('lbl-season') as HTMLInputElement).value = String(data.season ?? 1);
          setMode('points');
        }
      } catch {
        alert('Could not parse that file as editor JSON.');
      }
      (e.target as HTMLInputElement).value = '';
    });

    $('lbl-export').addEventListener('click', () => {
      const data = payload();
      const nameBase =
        (mode === 'points'
          ? (data as { slug?: string }).slug
          : (data as { screen?: string }).screen) || 'labels';
      const blob = new Blob([JSON.stringify(data, null, 2) + '\n'], {
        type: 'application/json',
      });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${nameBase}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    $('lbl-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(JSON.stringify(payload(), null, 2));
      const btn = $('lbl-copy');
      const old = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = old), 1200);
    });

    $('lbl-clear').addEventListener('click', () => {
      if (!confirm('Remove all points/zones for the current mode?')) return;
      if (mode === 'points') points = [];
      else zones = [];
      selectedN = null;
      selectedZone = -1;
      render();
    });

    ['lbl-slug', 'lbl-title', 'lbl-season', 'lbl-screen'].forEach((id) =>
      $(id).addEventListener('input', refreshJson),
    );

    restore();
    render();
  }
</script>

{/* is:global — pins, zones, and list rows are created with document.createElement,
   so they never receive Astro's scoped-style attribute; scoped rules would skip
   them entirely (pins then pile up unpositioned in the top-left corner). All
   selectors are namespaced with the lbl- prefix instead. */}
<style is:global>
  /* The editor needs the full page width — lift Starlight's narrow content
     column cap on this page only (same trick as the NAP planner). */
  main:has(#lbl-editor) {
    --sl-content-width: 100%;
  }
  #lbl-editor {
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .lbl-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
