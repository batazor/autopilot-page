        handovers: 'Handovers', addRow: '+ Handover', buffW: 'Buff',
        descCastle: 'The central objective of the season.',
        descCitadel: 'Inner capture point (stronghold).',
        descFort: 'Outer capture point.', descTurret: 'Castle turret.',
      },
      ru: {
        season: 'сезон / заметка', towers: 'Комплексы', rotate: 'Вид 45°',
        viewMap: 'Карта', viewTable: 'Таблица', viewGantt: 'График',
        thObject: 'Объект', thOwner: 'Владелец', thBuff: 'Бафф', thMark: 'Метка',
        thNote: 'Заметка', thHandovers: 'Передачи',
        facilities: 'Комплексы', thType: 'Тип',
        kindC: 'Цитадель', kindF: 'Форт', kindT: 'Комплекс',
