      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'nap-row-del';
      x.textContent = '✕';
      x.addEventListener('click', closeDetail);
      head.append(title, coords, x);
      card.appendChild(head);

      const info = document.createElement('div');
      info.className = 'nap-detail-info';
      info.textContent =
        s.kind === 'tower'
          ? `${T('buffW')}: ${s.buff!.booster} ${s.buff!.bonus} · L${s.buff!.level}`
          : T(s.kind === 'stronghold' ? 'descCitadel' : 'descFort');
      card.appendChild(info);

      // owner
      const ownRow = document.createElement('label');
      ownRow.className = 'nap-detail-row';
      const ownLbl = document.createElement('span');
      ownLbl.textContent = T('owner');
      const ownSel = document.createElement('select');
      const none = document.createElement('option');
      none.value = '';
      none.textContent = '—';
      ownSel.appendChild(none);
      for (const al of alliances) {
        const o = document.createElement('option');
        o.value = al.id;
        o.textContent = al.name || al.id;
        ownSel.appendChild(o);
      }
      ownSel.value = assignments[s.id] ?? '';
      ownSel.addEventListener('change', () => {
        if (ownSel.value) assignments[s.id] = ownSel.value;
        else delete assignments[s.id];
        render();
      });
      ownRow.append(ownLbl, ownSel);
      card.appendChild(ownRow);

      // marks
      const marksRow = document.createElement('div');
      marksRow.className = 'nap-detail-row';
      const marksLbl = document.createElement('span');
      marksLbl.textContent = T('marksTitle');
      const marksBox = document.createElement('div');
      marksBox.className = 'nap-detail-marks';
      for (const [key, mk] of Object.entries(MARKS)) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nap-mark-btn' + (marks[s.id]?.risk === key ? ' active' : '');
        btn.textContent = `${mk.emoji} ${markLabel(key)}`;
        btn.addEventListener('click', () => {
          const m = marks[s.id] ?? {};
          if (m.risk === key) delete m.risk;
          else m.risk = key;
          if (m.risk || m.note) marks[s.id] = m;
          else delete marks[s.id];
          render();
        });
        marksBox.appendChild(btn);
      }
      marksRow.append(marksLbl, marksBox);
      card.appendChild(marksRow);

      // note
      const noteRow = document.createElement('label');
      noteRow.className = 'nap-detail-row';
      const noteLbl = document.createElement('span');
      noteLbl.textContent = T('noteLabel');
      const note = document.createElement('input');
      note.type = 'text';
      note.value = marks[s.id]?.note ?? '';
      note.addEventListener('input', () => {
        const m = marks[s.id] ?? {};
        if (note.value.trim()) m.note = note.value.trim();
        else delete m.note;
        if (m.risk || m.note) marks[s.id] = m;
        else delete marks[s.id];
        save();
      });
      note.addEventListener('change', () => render());
      noteRow.append(noteLbl, note);
      card.appendChild(noteRow);

      // handovers for this object
      const schedHead = document.createElement('div');
      schedHead.className = 'nap-detail-sub';
      schedHead.textContent = T('handovers');
      card.appendChild(schedHead);
      const mine = rotations.filter((r) => r.id === s.id);
      for (const rr of mine) {
        const row = document.createElement('div');
        row.className = 'nap-detail-rot';
        const date = document.createElement('input');
        date.type = 'date';
        date.value = rr.date;
        date.addEventListener('change', () => {
          if (date.value) rr.date = date.value;
          sortRotations();
          render();
        });
        const time = document.createElement('input');
        time.type = 'time';
        time.value = rr.time ?? '';
        time.title = 'UTC';
        time.addEventListener('change', () => {
          if (time.value) rr.time = time.value;
          else delete rr.time;
          sortRotations();
          render();
        });
        const arrow = document.createElement('span');
        arrow.className = 'nap-rot-arrow';
        arrow.textContent = '→';
        const to = document.createElement('select');
        for (const al of alliances) {
          const o = document.createElement('option');
          o.value = al.id;
          o.textContent = al.name || al.id;
          o.selected = al.id === rr.to;
          to.appendChild(o);
        }
        to.addEventListener('change', () => {
          rr.to = to.value;
          render();
        });
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'nap-row-del';
        del.textContent = '✕';
        del.addEventListener('click', () => {
          rotations.splice(rotations.indexOf(rr), 1);
          render();
        });
        row.append(date, time, arrow, to, del);
        card.appendChild(row);
      }
      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'nap-rot-add';
      addBtn.textContent = T('addRow');
      addBtn.addEventListener('click', () => {
        if (!alliances.length) {
          alert(T('addAllianceFirst'));
          return;
        }
        rotations.push({ id: s.id, date: new Date().toISOString().slice(0, 10), to: alliances[0].id });
        sortRotations();
        render();
      });
      card.appendChild(addBtn);
    }

    ($('nap-detail') as HTMLElement).addEventListener('click', (e) => {
      if (e.target === $('nap-detail')) closeDetail();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDetail();
    });

    // --- roster table (Foundry-planner style) --------------------------------

    function applyView() {
      root.querySelectorAll<HTMLButtonElement>('.nap-view-btn').forEach((b) => {
        b.classList.toggle('active', b.dataset.view === view);
      });
      (map as HTMLElement).hidden = view !== 'map';
      (legend as HTMLElement).hidden = view !== 'map';
      ($('nap-table') as HTMLElement).hidden = view !== 'table';
      ($('nap-tbl-controls') as HTMLElement).hidden = view !== 'table';
      ($('nap-gantt') as HTMLElement).hidden = view !== 'gantt';
    }

    // --- ownership timeline (gantt) ------------------------------------------

    function renderGantt() {
      const host = $('nap-gantt');
      host.innerHTML = '';
      if (view !== 'gantt') return;
      const today = new Date().toISOString().slice(0, 10);
      const dates = rotations.map((r) => r.date);
      const DAY = 86400000;
      const minD = [today, ...dates].reduce((x, y) => (x < y ? x : y));
      const maxD = [today, ...dates].reduce((x, y) => (x > y ? x : y));
      const t0 = Date.parse(minD) - 2 * DAY;
      const t1 = Math.max(Date.parse(maxD) + 10 * DAY, t0 + 28 * DAY);
      const pct = (ms: number) => ((ms - t0) / (t1 - t0)) * 100;
      const fmt = (ms: number) => new Date(ms).toISOString().slice(5, 10);

      // axis: start, every handover date, today, end
      const axis = document.createElement('div');
      axis.className = 'nap-g-axis';
      const tickSet = [...new Set([t0, ...dates.map((d) => Date.parse(d)), Date.parse(today), t1])].sort(
        (x, y) => x - y,
      );
      for (const ms of tickSet) {
        const tick = document.createElement('span');
        tick.className = 'nap-g-tick';
        tick.style.left = `${pct(ms)}%`;
        tick.textContent = fmt(ms);
        axis.appendChild(tick);
      }
      host.appendChild(axis);

      const rows = [
        ...STRUCTURES.filter((st) => st.kind !== 'tower'),
        ...STRUCTURES.filter((st) => st.kind === 'tower' && rotations.some((r) => r.id === st.id)),
      ];
      for (const st of rows) {
        const row = document.createElement('div');
        row.className = 'nap-g-row';
        const label = document.createElement('button');
        label.type = 'button';
        label.className = 'nap-g-label';
        label.textContent = st.kind === 'tower' ? labelOf(st) : shortOf(st);
        label.title = labelOf(st);
        label.addEventListener('click', () => openDetail(st.id));
        const track = document.createElement('div');
        track.className = 'nap-g-track';
        // segments: base owner until first handover, then each handover's owner
        const mine = rotations.filter((r) => r.id === st.id);
        const bounds = [t0, ...mine.map((r) => Date.parse(r.date)), t1];
        let owner: string | undefined = assignments[st.id];
        for (let i = 0; i < bounds.length - 1; i++) {
          if (i > 0) owner = mine[i - 1].to;
          const a = allianceById(owner);
          const seg = document.createElement('div');
          seg.className = 'nap-g-seg' + (a ? '' : ' free');
          seg.style.left = `${pct(bounds[i])}%`;
          seg.style.width = `${pct(bounds[i + 1]) - pct(bounds[i])}%`;
          if (a) {
            seg.style.background = a.color;
            if (pct(bounds[i + 1]) - pct(bounds[i]) > 9) seg.textContent = a.name;
          }
          track.appendChild(seg);
        }
        const now = document.createElement('i');
        now.className = 'nap-g-now';
        now.style.left = `${pct(Date.parse(today))}%`;
        track.appendChild(now);
        row.append(label, track);
        host.appendChild(row);
      }
    }

    function renderTable() {
      const host = $('nap-table');
      host.innerHTML = '';
      if (view !== 'table') return;
      // owner filter options (kept outside the rebuilt table so focus survives)
      const ownerSel = $('nap-tbl-owner') as unknown as HTMLSelectElement;
      ownerSel.innerHTML = '';
      const opts: [string, string][] = [
        ['', T('fltAll')],
        ['__free', T('fltFree')],
        ...alliances.map((a) => [a.id, a.name || a.id] as [string, string]),
      ];
      for (const [v, label] of opts) {
        const o = document.createElement('option');
        o.value = v;
        o.textContent = label;
        ownerSel.appendChild(o);
      }
      if (!opts.some(([v]) => v === tblOwner)) tblOwner = '';
      ownerSel.value = tblOwner;
      const tbl = document.createElement('table');
      tbl.className = 'nap-tbl';
      const thead = document.createElement('thead');
      const trh = document.createElement('tr');
      for (const k of ['thObject', 'thOwner', 'thBuff', 'thMark', 'thNote', 'thHandovers']) {
        const th = document.createElement('th');
        th.textContent = T(k);
        trh.appendChild(th);
      }
      thead.appendChild(trh);
      tbl.appendChild(thead);
      const tbody = document.createElement('tbody');

      const q = tblQuery.trim().toLowerCase();
      const filterActive = !!q || !!tblOwner;
      const matches = (st: Structure): boolean => {
        const own = ownerId(st.id);
        if (tblOwner === '__free' && own) return false;
        if (tblOwner && tblOwner !== '__free' && own !== tblOwner) return false;
        if (!q) return true;
        const a = allianceById(own);
        const hay = [
          labelOf(st), shortOf(st), st.short, st.label, a?.name ?? '',
          marks[st.id]?.note ?? '',
          st.buff ? `${buffLabel(st.buff.type, st.buff.label)} ${st.buff.bonus}` : '',
        ]
          .join(' ')
          .toLowerCase();
        return hay.includes(q);
      };

      const addRow = (st: Structure) => {
        const own = ownerId(st.id);
        const a = allianceById(own);
        const tr = document.createElement('tr');
        tr.dataset.id = st.id;
        tr.dataset.a = own ?? '';
        if (a) tr.style.setProperty('--chip', a.color);

        const tdObj = document.createElement('td');
        tdObj.className = 'nap-tbl-obj';
        tdObj.title = `${labelOf(st)} (${st.x}, ${st.y})`;
        if (ICON_BY_KIND[st.kind]) {
          const ic = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          ic.setAttribute('class', 'nap-chip-ico');
          ic.setAttribute('viewBox', '0 0 24 24');
          ic.innerHTML = `<use href="#${ICON_BY_KIND[st.kind]}"></use>`;
          tdObj.appendChild(ic);
        } else if (st.buff) {
          const dot = document.createElement('i');
          dot.className = 'nap-tbl-dot';
          dot.style.background = st.buff.color;
          tdObj.appendChild(dot);
        }
        const bEl = document.createElement('b');
        bEl.textContent = st.kind === 'tower' ? labelOf(st) : shortOf(st);
        tdObj.appendChild(bEl);
        tdObj.addEventListener('click', () => openDetail(st.id));
        tr.appendChild(tdObj);

        const tdOwn = document.createElement('td');
        const ownSel = document.createElement('select');
        const none = document.createElement('option');
        none.value = '';
        none.textContent = '—';
        ownSel.appendChild(none);
        for (const al of alliances) {
          const o = document.createElement('option');
          o.value = al.id;
          o.textContent = al.name || al.id;
          ownSel.appendChild(o);
        }
        ownSel.value = assignments[st.id] ?? '';
        ownSel.disabled = !!viewDate;
        ownSel.addEventListener('change', () => {
          if (ownSel.value) assignments[st.id] = ownSel.value;
          else delete assignments[st.id];
          render();
        });
        tdOwn.appendChild(ownSel);
        tr.appendChild(tdOwn);

        const tdBuff = document.createElement('td');
        tdBuff.className = 'nap-tbl-buff';
        if (st.buff) {
          tdBuff.textContent = `${st.buff.booster}`;
          tdBuff.title = `${st.buff.bonus} · L${st.buff.level}`;
        } else {
          tdBuff.textContent = '—';
        }
        tr.appendChild(tdBuff);

        const tdMark = document.createElement('td');
        const markSel = document.createElement('select');
        const mnone = document.createElement('option');
        mnone.value = '';
        mnone.textContent = '—';
        markSel.appendChild(mnone);
        for (const [key, mk] of Object.entries(MARKS)) {
          const o = document.createElement('option');
          o.value = key;
          o.textContent = `${mk.emoji} ${markLabel(key)}`;
          markSel.appendChild(o);
        }
        markSel.value = marks[st.id]?.risk ?? '';
        markSel.disabled = !!viewDate;
        markSel.addEventListener('change', () => {
          const m = marks[st.id] ?? {};
          if (markSel.value) m.risk = markSel.value;
          else delete m.risk;
          if (m.risk || m.note) marks[st.id] = m;
          else delete marks[st.id];
          render();
        });
        tdMark.appendChild(markSel);
        tr.appendChild(tdMark);

        const tdNote = document.createElement('td');
        tdNote.className = 'nap-tbl-note';
        const note = document.createElement('input');
        note.type = 'text';
        note.value = marks[st.id]?.note ?? '';
        note.disabled = !!viewDate;
        note.addEventListener('input', () => {
          const m = marks[st.id] ?? {};
          if (note.value.trim()) m.note = note.value.trim();
          else delete m.note;
          if (m.risk || m.note) marks[st.id] = m;
          else delete marks[st.id];
          save();
        });
        note.addEventListener('change', () => render());
        tdNote.appendChild(note);
        tr.appendChild(tdNote);

        const tdRot = document.createElement('td');
        tdRot.className = 'nap-tbl-rot';
        const mine = rotations.filter((r) => r.id === st.id);
        const txt = document.createElement('span');
        txt.textContent = mine
          .map((r) => `${r.date.slice(5)}${r.time ? ' ' + r.time : ''} → ${allianceById(r.to)?.name ?? '?'}`)
          .join(', ');
        const plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'nap-tbl-plus';
        plus.textContent = '+';
        plus.title = T('addRow');
        plus.addEventListener('click', () => openDetail(st.id));
        tdRot.append(txt, plus);
        tr.appendChild(tdRot);

        tbody.appendChild(tr);
      };

      // Collapsible groups: citadels, fortresses, one per facility type. Any
      // active search/filter expands everything and hides empty groups.
      const section = (key: string, label: string, items: Structure[]) => {
        const found = items.filter(matches);
        if (filterActive && !found.length) return;
        const collapsed = !filterActive && tblCollapsed.has(key);
        const tr = document.createElement('tr');
        tr.className = 'nap-tbl-sec';
        const td = document.createElement('td');
        td.colSpan = 6;
        const done = items.filter((st) => ownerId(st.id)).length;
        td.textContent = `${collapsed ? '▸' : '▾'} ${label} · ${done}/${items.length}`;
        tr.appendChild(td);
        tr.addEventListener('click', () => {
          if (tblCollapsed.has(key)) tblCollapsed.delete(key);
          else tblCollapsed.add(key);
          renderTable();
        });
        tbody.appendChild(tr);
        if (!collapsed) found.forEach(addRow);
      };

      section('cit', T('citadels'), STRUCTURES.filter((st) => st.kind === 'stronghold'));
      section('fort', T('fortresses'), STRUCTURES.filter((st) => st.kind === 'fortress'));
      for (const t of TOWER_TYPES)
        section(
          `fac:${t.type}`,
          buffLabel(t.type, t.label),
          STRUCTURES.filter((st) => st.kind === 'tower' && st.buff!.type === t.type),
        );

      tbl.appendChild(tbody);
      host.appendChild(tbl);
    }

    function render() {
      applyView();
      renderMap();
      renderLegend();
      renderAlliances();
      renderObjects();
      renderSchedule();
      renderProgress();
      renderStats();
      renderTable();
      renderGantt();
      renderRewards();
      paintSelection();
      if (detailId) renderDetail();
      refreshJson();
    }

    // --- toolbar -------------------------------------------------------------

    $('nap-add').addEventListener('click', () => {
      const n = alliances.reduce((m, a) => Math.max(m, Number(a.id.replace(/\D/g, '')) || 0), 0) + 1;
      const a: Alliance = { id: `a${n}`, name: `ALL${n}`, color: PALETTE[(n - 1) % PALETTE.length] };
      alliances.push(a);
      selectedId = a.id;
      eraser = false;
      render();
      const inputs = allianceList.querySelectorAll<HTMLInputElement>('input[type=text]');
      inputs[inputs.length - 1]?.select();
    });

    eraserBtn.addEventListener('click', () => {
      eraser = !eraser;
      markBrush = null;
      paintSelection();
      save();
    });

    root.querySelectorAll<HTMLButtonElement>('.nap-mark-btn').forEach((b) => {
      b.addEventListener('click', () => {
        markBrush = markBrush === b.dataset.mark ? null : (b.dataset.mark ?? null);
        eraser = false;
        paintSelection();
        save();
      });
    });

    towersCheck.addEventListener('change', () => {
      showTowers = towersCheck.checked;
      if (!showTowers) focusType = null;
      render();
    });

    const rotateCheck = $('nap-rotate') as unknown as HTMLInputElement;
    rotateCheck.addEventListener('change', () => {
      rotated = rotateCheck.checked;
      render();
    });

    root.querySelectorAll<HTMLButtonElement>('.nap-lang-btn').forEach((b) => {
      b.addEventListener('click', () => {
        lang = (b.dataset.lang as Lang) ?? 'en';
        applyStaticLang();
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.nap-view-btn').forEach((b) => {
      b.addEventListener('click', () => {
        view = (b.dataset.view as 'map' | 'table' | 'gantt') ?? 'map';
        render();
      });
    });

    ($('nap-tbl-q') as HTMLInputElement).addEventListener('input', (e) => {
      tblQuery = (e.target as HTMLInputElement).value;
      renderTable();
    });
    ($('nap-tbl-owner') as unknown as HTMLSelectElement).addEventListener('change', (e) => {
      tblOwner = (e.target as HTMLSelectElement).value;
      renderTable();
    });

    $('nap-rot-add').addEventListener('click', () => {
      if (!alliances.length) {
        alert(T('addAllianceFirst'));
        return;
      }
      const today = new Date().toISOString().slice(0, 10);
      rotations.push({ id: 'fortress_1', date: today, to: alliances[0].id });
      sortRotations();
      render();
    });

    ($('nap-viewdate') as HTMLInputElement).addEventListener('change', (e) => {
      viewDate = (e.target as HTMLInputElement).value || null;
      render();
    });
    $('nap-viewnow').addEventListener('click', () => {
      viewDate = null;
      ($('nap-viewdate') as HTMLInputElement).value = '';
      render();
    });

    $('nap-season').addEventListener('input', refreshJson);

    $('nap-import').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data.type !== 'nap_plan' || !Array.isArray(data.alliances)) throw new Error('bad shape');
        applyPlan(data);
        selectedId = null;
        eraser = false;
        render();
      } catch {
        alert(T('badImport'));
      }
      (e.target as HTMLInputElement).value = '';
    });

    const fileBase = () =>
      (($('nap-season') as HTMLInputElement).value.trim() || 'nap-plan')
        .toLowerCase()
        .replace(/[^a-z0-9а-яё-]+/gi, '-')
        .replace(/^-+|-+$/g, '') || 'nap-plan';

    const download = (blob: Blob, name: string) => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      URL.revokeObjectURL(a.href);
    };

    $('nap-export').addEventListener('click', () => {
      download(
        new Blob([JSON.stringify(payload(), null, 2) + '\n'], { type: 'application/json' }),
        `${fileBase()}.json`,
      );
    });

    $('nap-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(JSON.stringify(payload(), null, 2));
      flash($('nap-copy'));
    });

    // --- share link: plan → deflate → base64url in the URL hash --------------

    const b64url = (bytes: Uint8Array) => {
      let s = '';
      for (let i = 0; i < bytes.length; i += 0x8000)
        s += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    };
    const unb64url = (s: string) =>
      Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
    const pipe = async (bytes: Uint8Array, stream: ReadableWritablePair<Uint8Array, Uint8Array>) =>
      new Uint8Array(
        await new Response(new Blob([bytes as BlobPart]).stream().pipeThrough(stream)).arrayBuffer(),
      );

    // 'z' prefix = deflate-raw, 'r' = raw JSON (no CompressionStream fallback).
    async function encodePlanHash(): Promise<string> {
      const bytes = new TextEncoder().encode(JSON.stringify(payload()));
      if (typeof CompressionStream !== 'undefined')
        return 'z' + b64url(await pipe(bytes, new CompressionStream('deflate-raw')));
      return 'r' + b64url(bytes);
    }
    async function decodePlanHash(h: string): Promise<unknown> {
      const bytes = unb64url(h.slice(1));
      const raw =
        h[0] === 'z' ? await pipe(bytes, new DecompressionStream('deflate-raw')) : bytes;
      return JSON.parse(new TextDecoder().decode(raw));
    }

    $('nap-share').addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#plan=${await encodePlanHash()}`;
      await navigator.clipboard.writeText(url);
      flash($('nap-share'), T('linkCopied'));
    });

    // --- PNG export: inline computed styles, rasterize, add title + legend ---

    $('nap-png').addEventListener('click', async () => {
      const svg = map.querySelector('svg');
      if (!svg) return;
      const clone = svg.cloneNode(true) as SVGSVGElement;
      // CSS classes / vars don't apply inside a standalone SVG image — inline
      // the computed presentation props onto the clone.
      const src = [svg as SVGElement, ...svg.querySelectorAll<SVGElement>('*')];
      const dst = [clone as SVGElement, ...clone.querySelectorAll<SVGElement>('*')];
      const PROPS = [
        'fill', 'stroke', 'stroke-width', 'stroke-dasharray', 'opacity',
        'font-size', 'font-family', 'font-weight', 'text-anchor',
        'dominant-baseline', 'paint-order',
      ];
      src.forEach((el, i) => {
        const cs = getComputedStyle(el);
        dst[i].setAttribute('style', PROPS.map((p) => `${p}:${cs.getPropertyValue(p)}`).join(';'));
      });
      const SIZE = 1080;
      clone.setAttribute('width', String(SIZE));
      clone.setAttribute('height', String(SIZE));
      const svgUrl = URL.createObjectURL(
        new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }),
      );
      try {
        const img = new Image();
        await new Promise((res, rej) => {
          img.onload = res;
          img.onerror = rej;
          img.src = svgUrl;
        });
        const pad = 24;
        const headH = 64;
        const rowH = 40;
        const legendH = alliances.length ? pad + alliances.length * rowH : pad;
        const canvas = document.createElement('canvas');
        canvas.width = SIZE;
        canvas.height = headH + SIZE + legendH;
        const ctx = canvas.getContext('2d')!;
        const rootCs = getComputedStyle(document.documentElement);
        const fg = rootCs.getPropertyValue('--sl-color-white').trim() || '#fff';
        const dim = rootCs.getPropertyValue('--sl-color-gray-3').trim() || fg;
        ctx.fillStyle = getComputedStyle(map).backgroundColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.textBaseline = 'middle';
        ctx.fillStyle = fg;
        ctx.font = '600 28px system-ui, sans-serif';
        ctx.fillText(($('nap-season') as HTMLInputElement).value.trim() || T('planTitle'), pad, headH / 2);
        ctx.drawImage(img, 0, headH, SIZE, SIZE);
        alliances.forEach((a, i) => {
          const y = headH + SIZE + pad / 2 + i * rowH + rowH / 2;
          ctx.fillStyle = a.color;
          ctx.fillRect(pad, y - 12, 24, 24);
          ctx.fillStyle = fg;
          ctx.font = '600 24px system-ui, sans-serif';
          ctx.fillText(a.name, pad + 40, y);
          ctx.fillStyle = dim;
          ctx.font = '400 20px system-ui, sans-serif';
          ctx.fillText(summary(a), pad + 240, y);
        });
        canvas.toBlob((blob) => {
          if (blob) download(blob, `${fileBase()}.png`);
        }, 'image/png');
      } finally {
        URL.revokeObjectURL(svgUrl);
      }
    });

    // --- CSV / Excel / ICS exports -------------------------------------------

    function exportRows(): string[][] {
      const kindLabel = (k: Structure['kind']) =>
        k === 'stronghold' ? T('kindC') : k === 'fortress' ? T('kindF') : T('kindT');
      const rows: string[][] = [
        [T('thObject'), T('thType'), 'X', 'Y', T('thOwner'), T('thBuff'), T('thMark'), T('thNote'), T('thHandovers')],
      ];
      for (const st of STRUCTURES) {
        const a = allianceById(assignments[st.id]);
        const m = marks[st.id];
        const mine = rotations
          .filter((r) => r.id === st.id)
          .map((r) => `${r.date}${r.time ? ' ' + r.time : ''} → ${allianceById(r.to)?.name ?? ''}`)
          .join('; ');
        rows.push([
          st.kind === 'tower' ? labelOf(st) : `${shortOf(st)} ${labelOf(st)}`,
          kindLabel(st.kind),
          String(st.x),
          String(st.y),
          a?.name ?? '',
          st.buff ? `${st.buff.booster} ${st.buff.bonus} L${st.buff.level}` : '',
          m?.risk ? markLabel(m.risk) : '',
          m?.note ?? '',
          mine,
        ]);
      }
      return rows;
    }

    $('nap-csv').addEventListener('click', () => {
      const csv =
        '\uFEFF' +
        exportRows()
          .map((r) => r.map((c) => `"${c.replace(/"/g, '""')}"`).join(','))
          .join('\r\n') +
        '\r\n';
      download(new Blob([csv], { type: 'text/csv;charset=utf-8' }), `${fileBase()}.csv`);
    });

    // Excel opens an HTML table saved as .xls regardless of CSV locale quirks.
    $('nap-xls').addEventListener('click', () => {
      const [head, ...rows] = exportRows();
      const html =
        `<html><head><meta charset="utf-8"></head><body><table border="1"><tr>` +
        head.map((h) => `<th>${esc(h)}</th>`).join('') +
        `</tr>` +
        rows.map((r) => `<tr>` + r.map((c) => `<td>${esc(c)}</td>`).join('') + `</tr>`).join('') +
        `</table></body></html>`;
      download(new Blob([html], { type: 'application/vnd.ms-excel' }), `${fileBase()}.xls`);
    });

    // Handover schedule as calendar events (1h display alarm) — real push
    // notifications on any device without needing a server.
    $('nap-ics').addEventListener('click', () => {
      const lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//autopilot//nap-planner//EN',
        'CALSCALE:GREGORIAN',
      ];
      const icsEsc = (t: string) => t.replace(/([,;\\])/g, '\\$1');
      for (const r of rotations) {
        const st = BY_ID.get(r.id);
        if (!st) continue;
        const summary = icsEsc(`⟳ ${shortOf(st)} → ${allianceById(r.to)?.name ?? '?'}`);
        lines.push('BEGIN:VEVENT', `UID:${r.id}-${r.date}-${(r.time ?? 'allday').replace(':', '')}@autopilot-nap`);
        if (r.time) {
          const dt = `${r.date.replace(/-/g, '')}T${r.time.replace(':', '')}00Z`;
          lines.push(`DTSTART:${dt}`, `DTEND:${dt}`);
        } else {
          lines.push(`DTSTART;VALUE=DATE:${r.date.replace(/-/g, '')}`);
        }
        lines.push(
          `SUMMARY:${summary}`,
          `DESCRIPTION:${icsEsc(($('nap-season') as HTMLInputElement).value.trim() || T('planTitle'))}`,
          'BEGIN:VALARM',
          'TRIGGER:-PT1H',
          'ACTION:DISPLAY',
          `DESCRIPTION:${summary}`,
          'END:VALARM',
          'END:VEVENT',
        );
      }
      lines.push('END:VCALENDAR');
      download(new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' }), `${fileBase()}.ics`);
    });

    // --- rewards reference ----------------------------------------------------

    function renderRewards() {
      const host = $('nap-rewards-body');
      host.innerHTML = '';
      const tbl = document.createElement('table');
      tbl.className = 'nap-tbl nap-rewards-tbl';
      const trh = document.createElement('tr');
      for (const k of ['colMinistry', 'colBuff', 'colBoosted']) {
        const th = document.createElement('th');
        th.textContent = T(k);
        trh.appendChild(th);
      }
      tbl.appendChild(trh);
      for (const [name, buff, boosted] of MINISTRIES[lang]) {
        const tr = document.createElement('tr');
        for (const cell of [name, buff, boosted]) {
          const td = document.createElement('td');
          td.textContent = cell;
          tr.appendChild(td);
        }
        tbl.appendChild(tr);
      }
      host.appendChild(tbl);
    }

    $('nap-reset').addEventListener('click', () => {
      if (!confirm(T('confirmReset'))) return;
      alliances = [];
      assignments = {};
      marks = {};
      rotations = [];
      selectedId = null;
      eraser = false;
      markBrush = null;
      viewDate = null;
      ($('nap-viewdate') as HTMLInputElement).value = '';
      ($('nap-season') as HTMLInputElement).value = '';
      render();
    });

    restore();
    applyStaticLang();
    render();

    // A shared #plan=... link overrides the local autosave (with consent).
    const hashPlan = location.hash.match(/^#plan=([A-Za-z0-9_-]+)$/);
    if (hashPlan) {
      decodePlanHash(hashPlan[1])
        .then((data) => {
          if ((data as { type?: string })?.type !== 'nap_plan') throw new Error('bad plan');
          if (
            alliances.length &&
            !confirm(T('confirmLink'))
          )
            return;
          applyPlan(data as Record<string, unknown>);
          selectedId = null;
          eraser = false;
          markBrush = null;
          render();
        })
        .catch(() => alert(T('badLink')))
        .finally(() => history.replaceState(null, '', location.pathname + location.search));
    }
  }
</script>

