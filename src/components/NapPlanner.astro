---
// Sunfire Castle NAP planner. Alliance leads divide the season territory —
// citadels (strongholds), fortresses, turrets and buff towers — between
// alliances of a non-aggression pact. Everything is client-side: the plan
// autosaves to localStorage and is shared as a small JSON file (or via
// clipboard), same flow as the label editor.
//
// Structure coordinates are game facts vendored from the main repo's
// games/wos/db/sunfire_castle_territory.yaml (absolute [col,row] tiles on the
// 1200x1200 kingdom map; identical on every server). IDs follow
// games/wos/core/sunfire_castle/territory.py: castle, turret_N, stronghold_N,
// fortress_N, <buff_type>_l<level>_<i>.
---

<div id="nap-planner" class="not-content">
  <div class="nap-toolbar">
    <div class="nap-lang" role="group" aria-label="Language">
      <button type="button" class="nap-lang-btn" data-lang="ru">RU</button>
      <button type="button" class="nap-lang-btn" data-lang="en">EN</button>
    </div>
    <label class="nap-season">
      <span data-i18n="season">season / note</span>
      <input id="nap-season" type="text" placeholder="S2 · NAP-4" spellcheck="false" />
    </label>
    <label class="nap-check">
      <input id="nap-towers" type="checkbox" checked />
      <span data-i18n="towers">Buff towers</span>
    </label>
    <label class="nap-check">
      <input id="nap-rotate" type="checkbox" checked />
      <span data-i18n="rotate">45° view</span>
    </label>
    <div class="nap-actions">
      <label class="nap-btn">
        <span data-i18n="import">Import JSON</span>
        <input id="nap-import" type="file" accept="application/json,.json" hidden />
      </label>
      <button type="button" id="nap-export" class="nap-btn primary" data-i18n="export">Download JSON</button>
      <button type="button" id="nap-copy" class="nap-btn" data-i18n="copy">Copy JSON</button>
      <button type="button" id="nap-share" class="nap-btn" data-i18n="share">Copy link</button>
      <button type="button" id="nap-png" class="nap-btn">PNG</button>
      <button type="button" id="nap-reset" class="nap-btn danger" data-i18n="reset">Reset</button>
    </div>
  </div>

  <div class="nap-body">
    <div>
      <div class="nap-tip" id="nap-tip">Add an alliance, select it, then click objects on the map.</div>
      <div class="nap-progress" id="nap-progress"></div>
      <div class="nap-map" id="nap-map"></div>
      <div class="nap-legend" id="nap-legend"></div>
    </div>
    <div class="nap-side">
      <div class="nap-side-head">
        <span data-i18n="alliances">Alliances</span>
        <button type="button" id="nap-add" class="nap-btn small" data-i18n="add">+ Add</button>
      </div>
      <ul class="nap-alliances" id="nap-alliances"></ul>
      <button type="button" id="nap-eraser" class="nap-eraser" data-i18n="eraser">Eraser — click an object to clear it</button>
      <div class="nap-marks" role="group" aria-label="Risk marks">
        <button type="button" class="nap-mark-btn" data-mark="snipe" data-i18n="snipe">🎯 Snipe</button>
        <button type="button" class="nap-mark-btn" data-mark="watch" data-i18n="watch">👁️ Watch</button>
        <button type="button" class="nap-mark-btn" data-mark="revenge" data-i18n="risk">⚠️ Risk</button>
      </div>
      <div class="nap-side-head"><span data-i18n="objects">Objects</span></div>
      <div class="nap-objects" id="nap-objects"></div>
      <div class="nap-side-head">
        <span data-i18n="schedule">Schedule</span>
        <span class="nap-viewat">
          <input id="nap-viewdate" type="date" />
          <button type="button" id="nap-viewnow" class="nap-btn small" hidden data-i18n="now">Now</button>
        </span>
      </div>
      <div class="nap-rotations" id="nap-rotations"></div>
      <button type="button" id="nap-rot-add" class="nap-rot-add" data-i18n="addHandover">+ Add handover</button>
    </div>
  </div>

  <details class="nap-json">
    <summary data-i18n="jsonPreview">JSON preview</summary>
    <pre><code id="nap-json-out">{}</code></pre>
  </details>
</div>

<script>
  // --- vendored territory facts (see frontmatter note) -----------------------

  type Buff = {
    type: string;
    label: string;
    bonus: string;
    color: string;
    level: number;
    booster: string;
  };
  type Structure = {
    id: string;
    kind: 'castle' | 'turret' | 'stronghold' | 'fortress' | 'tower';
    label: string;
    short: string;
    x: number;
    y: number;
    buff?: Buff;
  };

  const TOWER_TYPES: {
    type: string;
    label: string;
    bonus: string;
    color: string;
    levels: { level: number; booster: string; coords: [number, number][] }[];
  }[] = [
    {
      type: 'construction', label: 'Construction', bonus: 'Construction Speed', color: '#42a5f5',
      levels: [
        { level: 1, booster: '+5%', coords: [[1068,138],[537,138],[138,138],[138,666],[138,1038],[666,1068],[1068,567],[1068,1068]] },
        { level: 3, booster: '+8%', coords: [[486,327],[768,867],[867,567],[327,666]] },
      ],
    },
    {
      type: 'defense', label: 'Defense', bonus: 'Troop Defense', color: '#26c6da',
      levels: [
        { level: 2, booster: '+5%', coords: [[666,138],[438,267],[138,537],[237,768],[537,1038],[738,957],[1068,666],[957,438]] },
        { level: 4, booster: '+8%', coords: [[816,717],[387,717],[588,327]] },
      ],
    },
    {
      type: 'tech', label: 'Tech', bonus: 'Research Speed', color: '#ffa726',
      levels: [
        { level: 1, booster: '+5%', coords: [[957,237],[666,267],[237,237],[267,537],[237,957],[537,936],[936,537],[957,957]] },
        { level: 3, booster: '+8%', coords: [[867,327],[327,327],[327,867],[867,867]] },
      ],
    },
    {
      type: 'weapon', label: 'Weapons', bonus: 'Troop Attack', color: '#ef5350',
      levels: [
        { level: 2, booster: '+5%', coords: [[867,138],[366,138],[138,438],[138,867],[438,1068],[1068,327],[1068,867],[867,1068]] },
        { level: 4, booster: '+8%', coords: [[816,486],[387,486],[588,867]] },
      ],
    },
    {
      type: 'gathering', label: 'Gathering', bonus: 'Gathering Speed', color: '#ab47bc',
      levels: [
        { level: 1, booster: '+5%', coords: [[957,138],[537,87],[138,237],[87,666],[267,1068],[636,1137],[1137,567],[1068,936]] },
      ],
    },
    {
      type: 'production', label: 'Production', bonus: 'RSS Gathering Speed', color: '#66bb6a',
      levels: [
        { level: 1, booster: '+5%', coords: [[1068,237],[768,138],[237,138],[138,327],[138,957],[327,1038],[1068,747],[957,1068]] },
      ],
    },
    {
      type: 'training', label: 'Training', bonus: 'Training Speed', color: '#ffee58',
      levels: [
        { level: 2, booster: '+5%', coords: [[237,486],[138,747],[486,957],[768,1038],[957,747],[1068,486],[486,138],[768,237]] },
      ],
    },
    {
      type: 'expedition', label: 'Expedition', bonus: 'March Speed', color: '#f48fb1',
      levels: [
        { level: 3, booster: '+15%', coords: [[768,327],[327,567],[486,867],[867,666]] },
      ],
    },
  ];

  const CASTLE = { x: 597, y: 597 };
  const TURRETS: [number, number, string][] = [
    [593, 593, 'North Turret'], [603, 593, 'East Turret'],
    [603, 603, 'South Turret'], [593, 603, 'West Turret'],
  ];
  const STRONGHOLDS: [number, number][] = [[394, 597], [597, 794], [794, 597], [597, 394]];
  const FORTRESSES: [number, number][] = [
    [366, 957], [588, 957], [846, 957], [957, 828], [957, 606], [957, 348],
    [846, 237], [588, 237], [366, 237], [237, 348], [237, 588], [237, 828],
  ];
  // Territory bands (inclusive bboxes) — background context only.
  const ZONES: [number, number, number, number][] = [
    [300, 300, 900, 900], // outer (fortresses band)
    [450, 450, 750, 750], // inner ring (strongholds band)
    [552, 552, 647, 647], // castle core
  ];

  const STRUCTURES: Structure[] = [];
  STRUCTURES.push({ id: 'castle', kind: 'castle', label: 'Sunfire Castle', short: 'SC', x: CASTLE.x, y: CASTLE.y });
  TURRETS.forEach(([x, y, label], i) => {
    // Turrets hug the castle centre (±5 tiles) — exaggerate the display offset
    // so they stay clickable; tooltips keep the real coordinates.
    STRUCTURES.push({
      id: `turret_${i + 1}`, kind: 'turret', label, short: `T${i + 1}`,
      x: CASTLE.x + (x - CASTLE.x) * 9, y: CASTLE.y + (y - CASTLE.y) * 9,
    });
  });
  STRONGHOLDS.forEach(([x, y], i) => {
    STRUCTURES.push({
      id: `stronghold_${i + 1}`, kind: 'stronghold',
      label: `Citadel ${i + 1} (Stronghold ${i + 1})`, short: `C${i + 1}`, x, y,
    });
  });
  FORTRESSES.forEach(([x, y], i) => {
    STRUCTURES.push({ id: `fortress_${i + 1}`, kind: 'fortress', label: `Fortress ${i + 1}`, short: `F${i + 1}`, x, y });
  });
  for (const t of TOWER_TYPES) {
    for (const lv of t.levels) {
      lv.coords.forEach(([x, y], i) => {
        STRUCTURES.push({
          id: `${t.type}_l${lv.level}_${i + 1}`, kind: 'tower',
          label: `${t.label} L${lv.level}`, short: '', x, y,
          buff: { type: t.type, label: t.label, bonus: t.bonus, color: t.color, level: lv.level, booster: lv.booster },
        });
      });
    }
  }
  const BY_ID = new Map(STRUCTURES.map((s) => [s.id, s]));

  // --- editor ----------------------------------------------------------------

  type Alliance = { id: string; name: string; color: string };

  const root = document.getElementById('nap-planner');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const map = $('nap-map');
    const legend = $('nap-legend');
    const allianceList = $('nap-alliances');
    const objects = $('nap-objects');
    const tip = $('nap-tip');
    const jsonOut = $('nap-json-out');
    const eraserBtn = $('nap-eraser');
    const towersCheck = $('nap-towers') as unknown as HTMLInputElement;

    let alliances: Alliance[] = [];
    let assignments: Record<string, string> = {};
    let marks: Record<string, { risk?: string; note?: string }> = {};
    let selectedId: string | null = null;
    let eraser = false;
    let markBrush: string | null = null;
    let showTowers = true;
    let lastClicked: string | null = null;
    // Transient view focus: alliance-row hover / legend buff-type filter.
    let focusAlliance: string | null = null;
    let focusType: string | null = null;
    // Fort rotation schedule: ordered handovers + "view plan as of" date.
    let rotations: { id: string; date: string; to: string }[] = [];
    let viewDate: string | null = null;
    // Diamond (in-game) map orientation.
    let rotated = true;

    const LS_KEY = 'autopilot-nap-planner';
    const PALETTE = ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#a855f7', '#14b8a6', '#f97316', '#84cc16'];
    const MARKS: Record<string, { emoji: string; label: string }> = {
      snipe: { emoji: '🎯', label: 'Snipe target' },
      watch: { emoji: '👁️', label: 'Watch' },
      revenge: { emoji: '⚠️', label: 'Revenge risk' },
    };

    // --- i18n ---------------------------------------------------------------

    type Lang = 'en' | 'ru';
    let lang: Lang = navigator.language?.toLowerCase().startsWith('ru') ? 'ru' : 'en';
    const I18N: Record<Lang, Record<string, string>> = {
      en: {
        season: 'season / note', towers: 'Buff towers', rotate: '45° view',
        import: 'Import JSON', export: 'Download JSON', copy: 'Copy JSON',
        share: 'Copy link', reset: 'Reset', alliances: 'Alliances', add: '+ Add',
        eraser: 'Eraser — click an object to clear it',
        snipe: '🎯 Snipe', watch: '👁️ Watch', risk: '⚠️ Risk',
        objects: 'Objects', schedule: 'Schedule', now: 'Now',
        addHandover: '+ Add handover', jsonPreview: 'JSON preview',
        citadels: 'Citadels', fortresses: 'Fortresses', castleTurrets: 'Castle & turrets',
        tipDefault: 'Add an alliance, select it, then click objects on the map.',
        tipEraser: 'Eraser on — click an object to clear its alliance and marks.',
        tipMark: 'Marking “{0}” — click to toggle, double-click for a note.',
        tipPaint: 'Painting as “{0}” — click objects to assign, click again to unassign.',
        tipView: 'Viewing the plan as of {0} — press “Now” (Schedule) to edit again.',
        divided: 'Everything is divided ✓', left: 'Left to divide:',
        citadelW: 'citadels', fortW: 'forts', towerW: 'towers', turretW: 'turrets',
        castleW: 'castle', nothing: 'nothing yet',
        copied: 'Copied!', linkCopied: 'Link copied!',
        noHandovers: 'No handovers yet — plan who takes which fort next.',
        confirmReset: 'Clear the whole plan (alliances + assignments + marks + schedule)?',
        confirmLink: 'Load the plan from this link? It replaces your current plan.',
        badImport: 'Could not parse that file as a NAP plan JSON.',
        badLink: 'Could not read the plan from this link.',
        addAllianceFirst: 'Add an alliance first.',
        noteFor: 'Note for {0}:', legendHint: '{0} — click to highlight these towers',
        handover: 'scheduled handover', removeAlliance: 'Remove alliance (unassigns its objects)',
        allianceColor: 'Alliance color', planTitle: 'Sunfire NAP plan',
      },
      ru: {
        season: 'сезон / заметка', towers: 'Бафф-вышки', rotate: 'Вид 45°',
        import: 'Импорт JSON', export: 'Скачать JSON', copy: 'Копир. JSON',
        share: 'Ссылка на план', reset: 'Сброс', alliances: 'Альянсы', add: '+ Добавить',
        eraser: 'Ластик — клик по объекту очищает его',
        snipe: '🎯 Снайп', watch: '👁️ Следить', risk: '⚠️ Риск',
        objects: 'Объекты', schedule: 'Расписание', now: 'Сейчас',
        addHandover: '+ Добавить передачу', jsonPreview: 'JSON-превью',
        citadels: 'Цитадели', fortresses: 'Форты', castleTurrets: 'Замок и турели',
        tipDefault: 'Добавь альянс, выбери его и кликай объекты на карте.',
        tipEraser: 'Ластик — клик по объекту снимает альянс и метки.',
        tipMark: 'Метка «{0}» — клик ставит/снимает, даблклик — заметка.',
        tipPaint: 'Красим за «{0}» — клик назначает, повторный клик снимает.',
        tipView: 'Просмотр плана на {0} — нажми «Сейчас» (Расписание), чтобы редактировать.',
        divided: 'Всё поделено ✓', left: 'Осталось поделить:',
        citadelW: 'цитаделей', fortW: 'фортов', towerW: 'вышек', turretW: 'турелей',
        castleW: 'замок', nothing: 'пока пусто',
        copied: 'Скопировано!', linkCopied: 'Ссылка скопирована!',
        noHandovers: 'Передач пока нет — спланируй, кто берёт форт следующим.',
        confirmReset: 'Стереть весь план (альянсы + назначения + метки + расписание)?',
        confirmLink: 'Загрузить план из ссылки? Он заменит твой текущий план.',
        badImport: 'Не удалось прочитать файл как JSON плана НАП.',
        badLink: 'Не удалось прочитать план из ссылки.',
        addAllianceFirst: 'Сначала добавь альянс.',
        noteFor: 'Заметка для {0}:', legendHint: '{0} — клик подсветит эти вышки',
        handover: 'передача по расписанию', removeAlliance: 'Удалить альянс (снимет его объекты)',
        allianceColor: 'Цвет альянса', planTitle: 'План НАП Sunfire',
      },
    };
    const T = (k: string, ...args: string[]) => {
      let s = I18N[lang][k] ?? I18N.en[k] ?? k;
      args.forEach((a, i) => (s = s.replace(`{${i}}`, a)));
      return s;
    };
    // Proper plural forms: EN just drops the trailing 's' for n == 1; RU uses
    // the standard 1/2-4/5+ triple.
    const RU_PLURALS: Record<string, [string, string, string]> = {
      citadelW: ['цитадель', 'цитадели', 'цитаделей'],
      fortW: ['форт', 'форта', 'фортов'],
      towerW: ['вышка', 'вышки', 'вышек'],
      turretW: ['турель', 'турели', 'турелей'],
    };
    const plural = (n: number, key: string): string => {
      if (lang === 'ru' && RU_PLURALS[key]) {
        const forms = RU_PLURALS[key];
        const idx =
          n % 10 === 1 && n % 100 !== 11
            ? 0
            : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)
              ? 1
              : 2;
        return forms[idx];
      }
      const base = I18N.en[key] ?? key;
      return n === 1 ? base.replace(/s$/, '') : base;
    };
    const MARK_RU: Record<string, string> = { snipe: 'Снайп-цель', watch: 'Следить', revenge: 'Риск реванша' };
    const markLabel = (risk: string) => (lang === 'ru' ? MARK_RU[risk] : MARKS[risk].label);
    const BUFF_RU: Record<string, string> = {
      construction: 'Стройка', defense: 'Защита', tech: 'Наука', weapon: 'Оружие',
      gathering: 'Сбор', production: 'Производство', training: 'Обучение', expedition: 'Марш',
    };
    const buffLabel = (type: string, en: string) => (lang === 'ru' ? BUFF_RU[type] : en);
    const shortOf = (s: Structure) =>
      lang === 'ru' && (s.kind === 'stronghold' || s.kind === 'fortress')
        ? s.short.replace(/^C/, 'Ц').replace(/^F/, 'Ф')
        : s.short;
    function labelOf(s: Structure): string {
      if (lang !== 'ru') return s.label;
      const n = s.id.replace(/\D/g, '');
      if (s.kind === 'castle') return 'Замок Солнца';
      if (s.kind === 'turret') return `Турель ${n}`;
      if (s.kind === 'stronghold') return `Цитадель ${n}`;
      if (s.kind === 'fortress') return `Форт ${n}`;
      return `${BUFF_RU[s.buff!.type]} ур.${s.buff!.level}`;
    }
    function applyStaticLang() {
      root.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        el.textContent = T(el.dataset.i18n!);
      });
      root.querySelectorAll<HTMLButtonElement>('.nap-lang-btn').forEach((b) => {
        b.classList.toggle('active', b.dataset.lang === lang);
      });
    }
    const flash = (btn: HTMLElement, text?: string) => {
      const old = btn.textContent;
      btn.textContent = text ?? T('copied');
      setTimeout(() => (btn.textContent = old), 1200);
    };
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function payload(): Record<string, unknown> {
      return {
        type: 'nap_plan',
        version: 1,
        season: ($('nap-season') as HTMLInputElement).value.trim(),
        alliances,
        assignments,
        marks,
        rotations,
      };
    }

    function save() {
      try {
        localStorage.setItem(
          LS_KEY,
          JSON.stringify({
            alliances, assignments, marks, rotations, selectedId, eraser, showTowers, rotated, lang,
            season: ($('nap-season') as HTMLInputElement).value,
          }),
        );
      } catch {
        /* storage full / private mode — autosave is best-effort */
      }
    }

    function restore() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) return;
        const s = JSON.parse(raw);
        applyPlan(s);
        if (typeof s.selectedId === 'string' && (s.alliances ?? []).some((a: Alliance) => a.id === s.selectedId))
          selectedId = s.selectedId;
        if (s.eraser === true) eraser = true;
        if (s.showTowers === false) showTowers = false;
        if (s.rotated === false) rotated = false;
        if (s.lang === 'en' || s.lang === 'ru') lang = s.lang;
        towersCheck.checked = showTowers;
        ($('nap-rotate') as HTMLInputElement).checked = rotated;
      } catch {
        /* corrupt autosave — start clean */
      }
    }

    // Shared by restore() and JSON import: coerce fields, drop assignments that
    // point at unknown structures or unknown alliances.
    function applyPlan(data: { alliances?: unknown; assignments?: unknown; season?: unknown }) {
      alliances = (Array.isArray(data.alliances) ? data.alliances : []).map((a, i) => ({
        id: String((a as Alliance).id ?? `a${i + 1}`),
        name: String((a as Alliance).name ?? `Alliance ${i + 1}`),
        color: /^#[0-9a-fA-F]{3,8}$/.test(String((a as Alliance).color)) ? String((a as Alliance).color) : PALETTE[i % PALETTE.length],
      }));
      assignments = {};
      for (const [k, v] of Object.entries((data.assignments as Record<string, string>) ?? {})) {
        if (BY_ID.has(k) && alliances.some((a) => a.id === String(v))) assignments[k] = String(v);
      }
      marks = {};
      const rawMarks = ((data as { marks?: unknown }).marks ?? {}) as Record<
        string,
        { risk?: string; note?: string }
      >;
      for (const [k, v] of Object.entries(rawMarks)) {
        if (!BY_ID.has(k)) continue;
        const risk = MARKS[String(v?.risk)] ? String(v.risk) : undefined;
        const note = String(v?.note ?? '').trim();
        if (risk || note) marks[k] = { ...(risk ? { risk } : {}), ...(note ? { note } : {}) };
      }
      rotations = [];
      const rawRot = (data as { rotations?: unknown }).rotations;
      for (const r of Array.isArray(rawRot) ? rawRot : []) {
        const id = String((r as { id?: string })?.id ?? '');
        const date = String((r as { date?: string })?.date ?? '');
        const to = String((r as { to?: string })?.to ?? '');
        if (BY_ID.has(id) && /^\d{4}-\d{2}-\d{2}$/.test(date) && alliances.some((a) => a.id === to))
          rotations.push({ id, date, to });
      }
      sortRotations();
      ($('nap-season') as HTMLInputElement).value = String(data.season ?? '');
    }

    const allianceById = (id: string | undefined) => alliances.find((a) => a.id === id);

    // Effective owner of a structure: base assignment, then — when viewing the
    // plan as of a date — every scheduled handover with date <= viewDate
    // applied in order (rotations are kept sorted by date).
    function ownerId(id: string): string | undefined {
      let cur: string | undefined = assignments[id];
      if (viewDate) {
        for (const r of rotations) if (r.id === id && r.date <= viewDate) cur = r.to;
      }
      return cur;
    }

    function refreshJson() {
      jsonOut.textContent = JSON.stringify(payload(), null, 2);
      save();
    }

    // --- map (SVG rebuilt from state; one delegated click listener) ----------

    // Display transform: the in-game world map is shown diamond-wise, so the
    // 45° view rotates every point about the castle centre (600,600). Tooltips
    // keep the real tile coordinates.
    const K = Math.SQRT1_2;
    const rot = (x: number, y: number): [number, number] =>
      rotated
        ? [600 + K * (x - 600) + K * (y - 600), 600 - K * (x - 600) + K * (y - 600)]
        : [x, y];

    function marker(s: Structure): string {
      const own = ownerId(s.id);
      const a = allianceById(own);
      const fill = a ? a.color : '';
      const tag = a ? ` — ${a.name}` : '';
      const m = marks[s.id];
      const markTxt = m?.risk ? ` · ${markLabel(m.risk)}` : '';
      const noteTxt = m?.note ? ` · ${m.note}` : '';
      const scheduled = rotations.some((r) => r.id === s.id);
      const rotTxt = scheduled ? ` · ${T('handover')}` : '';
      const attrs = `data-id="${s.id}" data-a="${own ?? ''}"`;
      const [px, py] = rot(s.x, s.y);
      if (s.kind === 'tower') {
        const b = s.buff!;
        const title = `<title>${esc(`${buffLabel(b.type, b.label)} L${b.level} ${b.booster} ${b.bonus} (${s.x},${s.y})${tag}${markTxt}${noteTxt}${rotTxt}`)}</title>`;
        const badge = m?.risk
          ? `<text class="nap-m-mark" x="${px + 12}" y="${py - 12}" font-size="26">${MARKS[m.risk].emoji}</text>`
          : '';
        // Assigned tower: alliance-coloured disc with a buff-coloured ring. The
        // leading transparent circle only widens the touch target.
        return `<g ${attrs} data-t="${b.type}" class="nap-m nap-tower"><circle cx="${px}" cy="${py}" r="22" fill="transparent" /><circle cx="${px}" cy="${py}" r="11"
          fill="${a ? fill : b.color}" stroke="${a ? b.color : 'rgba(0,0,0,.55)'}" stroke-width="${a ? 5 : 2}" />${title}${badge}</g>`;
      }
      const r = s.kind === 'stronghold' ? 36 : s.kind === 'fortress' ? 31 : s.kind === 'castle' ? 26 : 14;
      const cls = a ? 'nap-m nap-fort assigned' : 'nap-m nap-fort';
      const title = `<title>${esc(`${labelOf(s)} (${Math.round(s.x)},${Math.round(s.y)})${tag}${markTxt}${noteTxt}${rotTxt}`)}</title>`;
      const badge = m?.risk
        ? `<text class="nap-m-mark" x="${px + r * 0.85}" y="${py - r * 0.85}" font-size="34">${MARKS[m.risk].emoji}</text>`
        : '';
      const rotBadge = scheduled
        ? `<text class="nap-m-rot" x="${px + r * 0.9}" y="${py + r * 0.9}" font-size="30">⟳</text>`
        : '';
      const style = a ? ` style="fill:${fill}"` : '';
      const text = `<text class="nap-m-label" x="${px}" y="${py}" font-size="${
        s.kind === 'castle' ? 22 : s.kind === 'turret' ? 15 : 27
      }">${esc(shortOf(s))}</text>`;
      const name = a
        ? `<text class="nap-m-tag" x="${px}" y="${py + r + 26}" font-size="24">${esc(a.name)}</text>`
        : '';
      return `<g ${attrs} class="${cls}">` +
        `<circle cx="${px}" cy="${py}" r="${r}"${style} />${title}${text}${name}${badge}${rotBadge}</g>`;
    }

    function renderMap() {
      const zoneTransform = rotated ? ` transform="rotate(-45 600 600)"` : '';
      const zones = ZONES.map(
        ([x0, y0, x1, y1], i) =>
          `<rect class="nap-zone z${i}" x="${x0}" y="${y0}" width="${x1 - x0}" height="${y1 - y0}" rx="14"${zoneTransform} />`,
      ).join('');
      const towers = showTowers
        ? STRUCTURES.filter((s) => s.kind === 'tower').map(marker).join('')
        : '';
      const forts = STRUCTURES.filter((s) => s.kind !== 'tower').map(marker).join('');
      // The diamond needs a wider viewBox: corner tiles like (138,138) land at
      // x ≈ -53 after rotation.
      const viewBox = rotated ? '-105 -115 1410 1410' : '60 60 1080 1080';
      map.innerHTML =
        `<svg viewBox="${viewBox}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Sunfire Castle territory map">` +
        zones + towers + forts + `</svg>`;
      // One-off feedback pop on the object that was just clicked.
      if (lastClicked) {
        map.querySelector(`[data-id="${lastClicked}"]`)?.classList.add('pop');
        lastClicked = null;
      }
    }

    map.addEventListener('click', (e) => {
      const el = (e.target as Element).closest('[data-id]');
      if (!el) return;
      clickStructure((el as HTMLElement).dataset.id!);
    });

    function clickStructure(id: string) {
      if (!BY_ID.has(id)) return;
      if (viewDate) {
        // Time-travel view is read-only — press "Now" to edit.
        tip.classList.add('warn');
        setTimeout(() => tip.classList.remove('warn'), 600);
        return;
      }
      lastClicked = id;
      if (markBrush) {
        const m = marks[id] ?? {};
        if (m.risk === markBrush) delete m.risk;
        else m.risk = markBrush;
        if (m.risk || m.note) marks[id] = m;
        else delete marks[id];
        render();
        return;
      }
      if (eraser) {
        delete assignments[id];
        delete marks[id];
        render();
        return;
      }
      if (!selectedId) {
        tip.classList.add('warn');
        setTimeout(() => tip.classList.remove('warn'), 600);
        return;
      }
      if (assignments[id] === selectedId) delete assignments[id];
      else assignments[id] = selectedId;
      render();
    }

    // Double-click attaches a free-text note (shown in the tooltip / chip title).
    function editNote(id: string) {
      const s = BY_ID.get(id);
      if (!s) return;
      const next = prompt(T('noteFor', labelOf(s)), marks[id]?.note ?? '');
      if (next === null) return;
      const m = marks[id] ?? {};
      if (next.trim()) m.note = next.trim();
      else delete m.note;
      if (m.risk || m.note) marks[id] = m;
      else delete marks[id];
      render();
    }

    // Hover sync map ↔ object chips (both are rebuilt DOM — delegate + repaint).
    function paintHover(id: string | null) {
      for (const el of [...map.querySelectorAll('.hl'), ...objects.querySelectorAll('.hl')])
        el.classList.remove('hl');
      if (!id) return;
      map.querySelector(`[data-id="${id}"]`)?.classList.add('hl');
      objects.querySelector(`[data-id="${id}"]`)?.classList.add('hl');
    }
    for (const host of [map, objects]) {
      host.addEventListener('pointerover', (e) => {
        const el = (e.target as Element).closest('[data-id]');
        paintHover(el ? ((el as HTMLElement).dataset.id ?? null) : null);
      });
      host.addEventListener('pointerleave', () => paintHover(null));
      host.addEventListener('dblclick', (e) => {
        const el = (e.target as Element).closest('[data-id]');
        if (el) editNote((el as HTMLElement).dataset.id!);
      });
    }

    // --- legend + panel ------------------------------------------------------

    function renderLegend() {
      legend.innerHTML = '';
      if (!showTowers) return;
      for (const t of TOWER_TYPES) {
        const towers = STRUCTURES.filter((s) => s.kind === 'tower' && s.buff!.type === t.type);
        const done = towers.filter((s) => ownerId(s.id)).length;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nap-legend-item' + (focusType === t.type ? ' active' : '');
        btn.title = T('legendHint', t.bonus);
        const dot = document.createElement('i');
        dot.style.background = t.color;
        btn.append(dot, `${buffLabel(t.type, t.label)} ${done}/${towers.length}`);
        btn.addEventListener('click', () => {
          focusType = focusType === t.type ? null : t.type;
          renderLegend();
          paintFocus();
        });
        legend.appendChild(btn);
      }
    }

    function renderProgress() {
      const left = (kind: Structure['kind']) =>
        STRUCTURES.filter((s) => s.kind === kind && !ownerId(s.id)).length;
      const cit = left('stronghold');
      const forts = left('fortress');
      const towers = left('tower');
      $('nap-progress').textContent =
        cit + forts + towers === 0
          ? T('divided')
          : `${T('left')} ${cit} ${plural(cit, 'citadelW')} · ${forts} ${plural(forts, 'fortW')} · ${towers} ${plural(towers, 'towerW')}`;
    }

    // Dim/glow layers: alliance-row hover wins, then the legend type filter,
    // then paint mode (other alliances' holdings fade while you paint).
    function paintFocus() {
      const apply = (el: Element) => {
        const isChip = !(el instanceof SVGElement);
        const a = el.getAttribute('data-a') || '';
        const t = el.getAttribute('data-t') || '';
        let dim = false;
        let glow = false;
        if (focusAlliance) {
          glow = a === focusAlliance;
          dim = !glow;
        } else if (focusType && !isChip) {
          glow = t === focusType;
          dim = !glow;
        } else if (!focusType && selectedId && !eraser && !markBrush) {
          dim = a !== '' && a !== selectedId;
        }
        el.classList.toggle('dim', dim);
        el.classList.toggle('glow', glow);
      };
      map.querySelectorAll('[data-id]').forEach(apply);
      objects.querySelectorAll('[data-id]').forEach(apply);
    }

    function summary(a: Alliance): string {
      const ids = STRUCTURES.filter((s) => ownerId(s.id) === a.id).map((s) => s.id);
      const n = (kind: Structure['kind']) => ids.filter((id) => BY_ID.get(id)!.kind === kind).length;
      const parts: string[] = [];
      if (n('castle')) parts.push(T('castleW'));
      if (n('stronghold')) parts.push(`${n('stronghold')} ${plural(n('stronghold'), 'citadelW')}`);
      if (n('fortress')) parts.push(`${n('fortress')} ${plural(n('fortress'), 'fortW')}`);
      if (n('turret')) parts.push(`${n('turret')} ${plural(n('turret'), 'turretW')}`);
      if (n('tower')) parts.push(`${n('tower')} ${plural(n('tower'), 'towerW')}`);
      return parts.length ? parts.join(' · ') : T('nothing');
    }

    function allianceRow(a: Alliance): HTMLLIElement {
      const li = document.createElement('li');
      li.className = selectedId === a.id && !eraser ? 'sel' : '';

      li.addEventListener('mouseenter', () => {
        focusAlliance = a.id;
        paintFocus();
      });
      li.addEventListener('mouseleave', () => {
        focusAlliance = null;
        paintFocus();
      });

      const swatch = document.createElement('input');
      swatch.type = 'color';
      swatch.value = a.color;
      swatch.title = T('allianceColor');
      swatch.addEventListener('input', () => {
        a.color = swatch.value;
        render();
      });

      const name = document.createElement('input');
      name.type = 'text';
      name.value = a.name;
      name.placeholder = 'tag';
      name.spellcheck = false;
      name.addEventListener('focus', () => selectAlliance(a.id));
      name.addEventListener('input', () => {
        a.name = name.value;
        renderMap();
        renderObjects();
        refreshJson();
        sum.textContent = summary(a);
      });

      const sum = document.createElement('span');
      sum.className = 'nap-sum';
      sum.textContent = summary(a);

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'nap-row-del';
      del.textContent = '✕';
      del.title = T('removeAlliance');
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        alliances = alliances.filter((x) => x.id !== a.id);
        for (const k of Object.keys(assignments)) if (assignments[k] === a.id) delete assignments[k];
        rotations = rotations.filter((r) => r.to !== a.id);
        if (selectedId === a.id) selectedId = null;
        if (focusAlliance === a.id) focusAlliance = null;
        render();
      });

      li.addEventListener('click', (e) => {
        if (e.target === swatch || e.target === name || e.target === del) return;
        selectAlliance(a.id);
      });
      li.append(swatch, name, sum, del);
      return li;
    }

    function selectAlliance(id: string) {
      selectedId = id;
      eraser = false;
      markBrush = null;
      paintSelection();
      save();
    }

    // Selection changes only toggle classes — no rebuild, keeps inputs focused.
    function paintSelection() {
      eraserBtn.classList.toggle('active', eraser);
      root.querySelectorAll<HTMLButtonElement>('.nap-mark-btn').forEach((b) => {
        b.classList.toggle('active', markBrush === b.dataset.mark);
      });
      const rows = allianceList.querySelectorAll('li');
      alliances.forEach((a, i) => {
        rows[i]?.classList.toggle('sel', selectedId === a.id && !eraser && !markBrush);
      });
      tip.textContent = viewDate
        ? T('tipView', viewDate)
        : eraser
          ? T('tipEraser')
          : markBrush
            ? T('tipMark', `${MARKS[markBrush].emoji} ${markLabel(markBrush)}`)
            : selectedId
              ? T('tipPaint', allianceById(selectedId)?.name ?? '')
              : T('tipDefault');
      paintFocus();
    }

    function renderAlliances() {
      allianceList.innerHTML = '';
      alliances.forEach((a) => allianceList.appendChild(allianceRow(a)));
    }

    function objectChip(s: Structure): HTMLButtonElement {
      const own = ownerId(s.id);
      const a = allianceById(own);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'nap-chip' + (a ? ' assigned' : '');
      b.dataset.id = s.id;
      b.dataset.a = own ?? '';
      const m = marks[s.id];
      b.title = labelOf(s) + (m?.note ? ` — ${m.note}` : '');
      if (a) b.style.setProperty('--chip', a.color);
      if (m?.risk) {
        const em = document.createElement('span');
        em.textContent = MARKS[m.risk].emoji;
        b.appendChild(em);
      }
      const short = document.createElement('b');
      short.textContent = shortOf(s) || labelOf(s);
      b.appendChild(short);
      const owner = document.createElement('span');
      owner.textContent = a ? a.name : '—';
      b.appendChild(owner);
      if (rotations.some((r) => r.id === s.id)) {
        const sched = document.createElement('span');
        sched.className = 'nap-chip-rot';
        sched.textContent = '⟳';
        b.appendChild(sched);
      }
      b.addEventListener('click', () => clickStructure(s.id));
      return b;
    }

    function renderObjects() {
      objects.innerHTML = '';
      const groups: [string, Structure[]][] = [
        [T('citadels'), STRUCTURES.filter((s) => s.kind === 'stronghold')],
        [T('fortresses'), STRUCTURES.filter((s) => s.kind === 'fortress')],
        [T('castleTurrets'), STRUCTURES.filter((s) => s.kind === 'castle' || s.kind === 'turret')],
      ];
      for (const [label, items] of groups) {
        const h = document.createElement('div');
        h.className = 'nap-group';
        h.textContent = label;
        objects.appendChild(h);
        const row = document.createElement('div');
        row.className = 'nap-chips';
        items.forEach((s) => row.appendChild(objectChip(s)));
        objects.appendChild(row);
      }
    }

    // --- schedule (fort handovers) -------------------------------------------

    const sortRotations = () =>
      rotations.sort((x, y) => x.date.localeCompare(y.date) || x.id.localeCompare(y.id));

    function renderSchedule() {
      const host = $('nap-rotations');
      host.innerHTML = '';
      ($('nap-viewnow') as HTMLButtonElement).hidden = !viewDate;
      const options = STRUCTURES.filter((s) => s.kind !== 'tower');
      rotations.forEach((rr, i) => {
        const row = document.createElement('div');
        row.className = 'nap-rot-row';

        const obj = document.createElement('select');
        for (const s of options) {
          const o = document.createElement('option');
          o.value = s.id;
          o.textContent = shortOf(s);
          o.selected = s.id === rr.id;
          obj.appendChild(o);
        }
        obj.title = labelOf(BY_ID.get(rr.id)!);
        obj.addEventListener('change', () => {
          rr.id = obj.value;
          render();
        });

        const date = document.createElement('input');
        date.type = 'date';
        date.value = rr.date;
        date.addEventListener('change', () => {
          if (date.value) rr.date = date.value;
          sortRotations();
          render();
        });

        const arrow = document.createElement('span');
        arrow.className = 'nap-rot-arrow';
        arrow.textContent = '→';

        const to = document.createElement('select');
        for (const a of alliances) {
          const o = document.createElement('option');
          o.value = a.id;
          o.textContent = a.name || a.id;
          o.selected = a.id === rr.to;
          to.appendChild(o);
        }
        to.addEventListener('change', () => {
          rr.to = to.value;
          render();
        });

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'nap-row-del';
        del.textContent = '✕';
        del.addEventListener('click', () => {
          rotations.splice(i, 1);
          render();
        });

        row.append(obj, date, arrow, to, del);
        host.appendChild(row);
      });
      if (!rotations.length) {
        const empty = document.createElement('div');
        empty.className = 'nap-rot-empty';
        empty.textContent = T('noHandovers');
        host.appendChild(empty);
      }
    }

    function render() {
      renderMap();
      renderLegend();
      renderAlliances();
      renderObjects();
      renderSchedule();
      renderProgress();
      paintSelection();
      refreshJson();
    }

    // --- toolbar -------------------------------------------------------------

    $('nap-add').addEventListener('click', () => {
      const n = alliances.reduce((m, a) => Math.max(m, Number(a.id.replace(/\D/g, '')) || 0), 0) + 1;
      const a: Alliance = { id: `a${n}`, name: `ALL${n}`, color: PALETTE[(n - 1) % PALETTE.length] };
      alliances.push(a);
      selectedId = a.id;
      eraser = false;
      render();
      const inputs = allianceList.querySelectorAll<HTMLInputElement>('input[type=text]');
      inputs[inputs.length - 1]?.select();
    });

    eraserBtn.addEventListener('click', () => {
      eraser = !eraser;
      markBrush = null;
      paintSelection();
      save();
    });

    root.querySelectorAll<HTMLButtonElement>('.nap-mark-btn').forEach((b) => {
      b.addEventListener('click', () => {
        markBrush = markBrush === b.dataset.mark ? null : (b.dataset.mark ?? null);
        eraser = false;
        paintSelection();
        save();
      });
    });

    towersCheck.addEventListener('change', () => {
      showTowers = towersCheck.checked;
      if (!showTowers) focusType = null;
      render();
    });

    const rotateCheck = $('nap-rotate') as unknown as HTMLInputElement;
    rotateCheck.addEventListener('change', () => {
      rotated = rotateCheck.checked;
      render();
    });

    root.querySelectorAll<HTMLButtonElement>('.nap-lang-btn').forEach((b) => {
      b.addEventListener('click', () => {
        lang = (b.dataset.lang as Lang) ?? 'en';
        applyStaticLang();
        render();
      });
    });

    $('nap-rot-add').addEventListener('click', () => {
      if (!alliances.length) {
        alert(T('addAllianceFirst'));
        return;
      }
      const today = new Date().toISOString().slice(0, 10);
      rotations.push({ id: 'fortress_1', date: today, to: alliances[0].id });
      sortRotations();
      render();
    });

    ($('nap-viewdate') as HTMLInputElement).addEventListener('change', (e) => {
      viewDate = (e.target as HTMLInputElement).value || null;
      render();
    });
    $('nap-viewnow').addEventListener('click', () => {
      viewDate = null;
      ($('nap-viewdate') as HTMLInputElement).value = '';
      render();
    });

    $('nap-season').addEventListener('input', refreshJson);

    $('nap-import').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data.type !== 'nap_plan' || !Array.isArray(data.alliances)) throw new Error('bad shape');
        applyPlan(data);
        selectedId = null;
        eraser = false;
        render();
      } catch {
        alert(T('badImport'));
      }
      (e.target as HTMLInputElement).value = '';
    });

    const fileBase = () =>
      (($('nap-season') as HTMLInputElement).value.trim() || 'nap-plan')
        .toLowerCase()
        .replace(/[^a-z0-9а-яё-]+/gi, '-')
        .replace(/^-+|-+$/g, '') || 'nap-plan';

    const download = (blob: Blob, name: string) => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      URL.revokeObjectURL(a.href);
    };

    $('nap-export').addEventListener('click', () => {
      download(
        new Blob([JSON.stringify(payload(), null, 2) + '\n'], { type: 'application/json' }),
        `${fileBase()}.json`,
      );
    });

    $('nap-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(JSON.stringify(payload(), null, 2));
      flash($('nap-copy'));
    });

    // --- share link: plan → deflate → base64url in the URL hash --------------

    const b64url = (bytes: Uint8Array) => {
      let s = '';
      for (let i = 0; i < bytes.length; i += 0x8000)
        s += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    };
    const unb64url = (s: string) =>
      Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
    const pipe = async (bytes: Uint8Array, stream: ReadableWritablePair<Uint8Array, Uint8Array>) =>
      new Uint8Array(
        await new Response(new Blob([bytes as BlobPart]).stream().pipeThrough(stream)).arrayBuffer(),
      );

    // 'z' prefix = deflate-raw, 'r' = raw JSON (no CompressionStream fallback).
    async function encodePlanHash(): Promise<string> {
      const bytes = new TextEncoder().encode(JSON.stringify(payload()));
      if (typeof CompressionStream !== 'undefined')
        return 'z' + b64url(await pipe(bytes, new CompressionStream('deflate-raw')));
      return 'r' + b64url(bytes);
    }
    async function decodePlanHash(h: string): Promise<unknown> {
      const bytes = unb64url(h.slice(1));
      const raw =
        h[0] === 'z' ? await pipe(bytes, new DecompressionStream('deflate-raw')) : bytes;
      return JSON.parse(new TextDecoder().decode(raw));
    }

    $('nap-share').addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#plan=${await encodePlanHash()}`;
      await navigator.clipboard.writeText(url);
      flash($('nap-share'), T('linkCopied'));
    });

    // --- PNG export: inline computed styles, rasterize, add title + legend ---

    $('nap-png').addEventListener('click', async () => {
      const svg = map.querySelector('svg');
      if (!svg) return;
      const clone = svg.cloneNode(true) as SVGSVGElement;
      // CSS classes / vars don't apply inside a standalone SVG image — inline
      // the computed presentation props onto the clone.
      const src = [svg as SVGElement, ...svg.querySelectorAll<SVGElement>('*')];
      const dst = [clone as SVGElement, ...clone.querySelectorAll<SVGElement>('*')];
      const PROPS = [
        'fill', 'stroke', 'stroke-width', 'stroke-dasharray', 'opacity',
        'font-size', 'font-family', 'font-weight', 'text-anchor',
        'dominant-baseline', 'paint-order',
      ];
      src.forEach((el, i) => {
        const cs = getComputedStyle(el);
        dst[i].setAttribute('style', PROPS.map((p) => `${p}:${cs.getPropertyValue(p)}`).join(';'));
      });
      const SIZE = 1080;
      clone.setAttribute('width', String(SIZE));
      clone.setAttribute('height', String(SIZE));
      const svgUrl = URL.createObjectURL(
        new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }),
      );
      try {
        const img = new Image();
        await new Promise((res, rej) => {
          img.onload = res;
          img.onerror = rej;
          img.src = svgUrl;
        });
        const pad = 24;
        const headH = 64;
        const rowH = 40;
        const legendH = alliances.length ? pad + alliances.length * rowH : pad;
        const canvas = document.createElement('canvas');
        canvas.width = SIZE;
        canvas.height = headH + SIZE + legendH;
        const ctx = canvas.getContext('2d')!;
        const rootCs = getComputedStyle(document.documentElement);
        const fg = rootCs.getPropertyValue('--sl-color-white').trim() || '#fff';
        const dim = rootCs.getPropertyValue('--sl-color-gray-3').trim() || fg;
        ctx.fillStyle = getComputedStyle(map).backgroundColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.textBaseline = 'middle';
        ctx.fillStyle = fg;
        ctx.font = '600 28px system-ui, sans-serif';
        ctx.fillText(($('nap-season') as HTMLInputElement).value.trim() || T('planTitle'), pad, headH / 2);
        ctx.drawImage(img, 0, headH, SIZE, SIZE);
        alliances.forEach((a, i) => {
          const y = headH + SIZE + pad / 2 + i * rowH + rowH / 2;
          ctx.fillStyle = a.color;
          ctx.fillRect(pad, y - 12, 24, 24);
          ctx.fillStyle = fg;
          ctx.font = '600 24px system-ui, sans-serif';
          ctx.fillText(a.name, pad + 40, y);
          ctx.fillStyle = dim;
          ctx.font = '400 20px system-ui, sans-serif';
          ctx.fillText(summary(a), pad + 240, y);
        });
        canvas.toBlob((blob) => {
          if (blob) download(blob, `${fileBase()}.png`);
        }, 'image/png');
      } finally {
        URL.revokeObjectURL(svgUrl);
      }
    });

    $('nap-reset').addEventListener('click', () => {
      if (!confirm(T('confirmReset'))) return;
      alliances = [];
      assignments = {};
      marks = {};
      rotations = [];
      selectedId = null;
      eraser = false;
      markBrush = null;
      viewDate = null;
      ($('nap-viewdate') as HTMLInputElement).value = '';
      ($('nap-season') as HTMLInputElement).value = '';
      render();
    });

    restore();
    applyStaticLang();
    render();

    // A shared #plan=... link overrides the local autosave (with consent).
    const hashPlan = location.hash.match(/^#plan=([A-Za-z0-9_-]+)$/);
    if (hashPlan) {
      decodePlanHash(hashPlan[1])
        .then((data) => {
          if ((data as { type?: string })?.type !== 'nap_plan') throw new Error('bad plan');
          if (
            alliances.length &&
            !confirm(T('confirmLink'))
          )
            return;
          applyPlan(data as Record<string, unknown>);
          selectedId = null;
          eraser = false;
          markBrush = null;
          render();
        })
        .catch(() => alert(T('badLink')))
        .finally(() => history.replaceState(null, '', location.pathname + location.search));
    }
  }
</script>

