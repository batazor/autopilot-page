    ru: [
      ['Президент', '+5% атака / защита / леталь / здоровье войск', '—'],
      ['Вице-президент', '+10% скорость исследований / стройки / обучения', '+15%'],
      ['Министр внутренних дел', '+80% производство ресурсов', '+120%'],
      ['Министр здравоохранения', '+100% скорость лечения · +5000 лазарет', '+150% · +7500'],
      ['Министр обороны', '+10% леталь войск', '+15%'],
      ['Министр стратегии', '+5% атака войск · +2500 отряд', '+8% · +3750'],
      ['Министр образования', '+50% скорость обучения · +200 вместимость', '+75% · +300'],
    ],
  };

  // Stylized silhouettes (original vector art — the game's own sprites are
  // copyrighted, so we draw our own in a similar spirit).
  const SVG_DEFS = `<defs>
    <symbol id="nap-ico-castle" viewBox="0 0 24 24">
      <path fill="currentColor" d="M3 21V10h2V6h3v4h3V6h2v4h3V6h3v4h2v11h-6v-5h-4v5Z"/>
    </symbol>
    <symbol id="nap-ico-citadel" viewBox="0 0 24 24">
      <rect fill="currentColor" x="6.4" y="6.4" width="11.2" height="11.2" rx="2" transform="rotate(45 12 12)"/>
    </symbol>
    <symbol id="nap-ico-fort" viewBox="0 0 24 24">
      <path fill="currentColor" d="M7 21V8h2V5h2v3h2V5h2v3h2v13h-3.5v-4h-3v4Z"/>
    </symbol>
    <symbol id="nap-ico-turret" viewBox="0 0 24 24">
      <path fill="currentColor" d="M9 21v-9H7V7h2V5h2v2h2V5h2v2h2v5h-2v9Z"/>
    </symbol>
  </defs>`;

  // --- editor ----------------------------------------------------------------

  type Alliance = { id: string; name: string; color: string };

  const root = document.getElementById('nap-planner');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const map = $('nap-map');
    const legend = $('nap-legend');
    const allianceList = $('nap-alliances');
    const objects = $('nap-objects');
    const tip = $('nap-tip');
    const jsonOut = $('nap-json-out');
    const eraserBtn = $('nap-eraser');
    const towersCheck = $('nap-towers') as unknown as HTMLInputElement;

    let alliances: Alliance[] = [];
    let assignments: Record<string, string> = {};
    let marks: Record<string, { risk?: string; note?: string }> = {};
    let selectedId: string | null = null;
    let eraser = false;
    let markBrush: string | null = null;
    let showTowers = true;
    let lastClicked: string | null = null;
    // Transient view focus: alliance-row hover / legend buff-type filter.
    let focusAlliance: string | null = null;
    let focusType: string | null = null;
    // Fort rotation schedule: ordered handovers + "view plan as of" date.
    // `time` (HH:MM, UTC battle slot) is optional.
    let rotations: { id: string; date: string; time?: string; to: string }[] = [];
    let viewDate: string | null = null;
    // Diamond (in-game) map orientation.
    let rotated = true;
    // Object whose detail card is open.
    let detailId: string | null = null;
    // Left column representation: map or roster table.
    let view: 'map' | 'table' | 'gantt' = 'map';
    // Roster-table search/filter + collapsed groups (facility types start
    // collapsed; any active search/filter expands everything).
    let tblQuery = '';
    let tblOwner = ''; // '' = all, '__free' = unassigned, else alliance id
    const tblCollapsed = new Set<string>(TOWER_TYPES.map((t) => `fac:${t.type}`));

    const LS_KEY = 'autopilot-nap-planner';
    const PALETTE = ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#a855f7', '#14b8a6', '#f97316', '#84cc16'];
    const MARKS: Record<string, { emoji: string; label: string }> = {
      snipe: { emoji: '🎯', label: 'Snipe target' },
      watch: { emoji: '👁️', label: 'Watch' },
      revenge: { emoji: '⚠️', label: 'Revenge risk' },
    };

    // --- i18n ---------------------------------------------------------------

    type Lang = 'en' | 'ru';
    let lang: Lang = navigator.language?.toLowerCase().startsWith('ru') ? 'ru' : 'en';
    const I18N: Record<Lang, Record<string, string>> = {
      en: {
