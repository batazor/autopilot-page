        tipView: 'Viewing the plan as of {0} — press “Now” (Schedule) to edit again.',
        divided: 'Everything is divided ✓', left: 'Left to divide:',
        citadelW: 'citadels', fortW: 'forts', towerW: 'facilities',
        nothing: 'nothing yet',
        copied: 'Copied!', linkCopied: 'Link copied!',
        noHandovers: 'No handovers yet — plan who takes which fort next.',
        confirmReset: 'Clear the whole plan (alliances + assignments + marks + schedule)?',
